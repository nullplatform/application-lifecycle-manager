#!/bin/bash

CURRENT_DIR=$(dirname "${BASH_SOURCE[0]}")

# shellcheck source=scripts/workflow_skip
source "$CURRENT_DIR/../workflow_skip"

# Workflow steps are sourced into one shared shell, so this must `return` and not `exit`.
#
# The platform calls this one the IMAGE repository (workflowSkipConfig's
# createImageRepository); here it is the asset repository. Same thing: the ECR or
# docker-server registry the application's images are pushed to.
if workflow_skip_step CREATE_ASSET_REPOSITORY createImageRepository; then
  echo "Skipping asset repository creation"
  return 0
fi

ASSET_REPOSITORY=$(np provider list --categories assets-repository --nrn "$NRN" --format json | jq ".results[0]")

if [[ -n "$ASSET_REPOSITORY_PROVIDER" ]]; then
  echo "Using ASSET_REPOSITORY_PROVIDER from environment: $ASSET_REPOSITORY_PROVIDER"
else
  ASSET_REPOSITORY_SPEC=$(echo "$ASSET_REPOSITORY" | jq -r .specification_id)
  ASSET_REPOSITORY_PROVIDER=$(np provider specification read --id "$ASSET_REPOSITORY_SPEC" --format json | jq -r .slug)

  echo "No ASSET_REPOSITORY_PROVIDER configured from environment, will use the provider configured in platform settings: $ASSET_REPOSITORY_PROVIDER"
fi

ASSET_REPOSITORY_SCRIPT_PATH="scripts/asset-repo/$ASSET_REPOSITORY_PROVIDER"

export ASSET_REPOSITORY_TYPE
export ASSET_REPOSITORY

export ASSET_REPOSITORY_SCRIPT_PATH

np service workflow exec --workflow workflows/create_asset_repository.yaml