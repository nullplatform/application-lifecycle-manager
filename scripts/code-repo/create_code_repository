#!/bin/bash

CURRENT_DIR=$(dirname "${BASH_SOURCE[0]}")

# shellcheck source=scripts/workflow_skip
source "$CURRENT_DIR/../workflow_skip"

# Workflow steps are sourced into one shared shell, so this must `return` and not `exit`:
# an `exit` here would end that shell and silently skip every later step, including asset
# repository creation.
if workflow_skip_step CREATE_CODE_REPOSITORY createCodeRepository; then
  echo "Skipping code repository creation"
  return 0
fi

REPOSITORY_URL=$(echo "$APPLICATION" | jq -r .repository_url)
TEMPLATE_ID=$(echo "$APPLICATION" | jq -r '.template_id // empty' )

if [[ -n "$TEMPLATE_ID" ]]; then
  CODE_REPOSITORY_STRATEGY=create

  TEMPLATE_READ_OUTPUT=$(np template read --id "$TEMPLATE_ID" --format json 2>&1)
  TEMPLATE_READ_EXIT=$?

  if [[ "$TEMPLATE_READ_EXIT" -ne 0 ]]; then
    echo "ERROR: failed to read template $TEMPLATE_ID (exit $TEMPLATE_READ_EXIT): $TEMPLATE_READ_OUTPUT"
    exit 1
  fi

  TEMPLATE_URL=$(echo "$TEMPLATE_READ_OUTPUT" | jq -r '.url // empty')

  export TEMPLATE_ID
  export TEMPLATE_URL
else
  CODE_REPOSITORY_STRATEGY=import
fi

REPOSITORY_NAME=$(basename "$REPOSITORY_URL")

if [[ -n "$CODE_REPOSITORY_PROVIDER" ]]; then
  echo "Using CODE_REPOSITORY_PROVIDER from environment: $CODE_REPOSITORY_PROVIDER"
else
  ACCOUNT=$(np account read --id "$ACCOUNT_ID" --format json)

  CODE_REPOSITORY_PROVIDER=$(echo "$ACCOUNT" | jq -r .repository_provider)

  echo "No CODE_REPOSITORY_PROVIDER configured from environment, will use the provider configured in the nullplatform account: $CODE_REPOSITORY_PROVIDER"
fi

# A provider configuration only identifies itself by its specification_id, so this map is what
# lets us pick the configuration that belongs to CODE_REPOSITORY_PROVIDER. Without it, an account
# with more than one code-repository configuration would get whichever one the API returned first.
code_repository_specification_id() {
  case "$1" in
    github)       echo "1043b379-9fa8-4d2d-bc18-9c5b0d3038f2" ;;
    gitlab)       echo "2ff2fe2f-6434-48be-aed2-be22d4d4e77c" ;;
    bitbucket)    echo "ca7019c5-f7da-4b79-8fd6-28afbaea366b" ;;
    azure-devops) echo "cc9475fa-1cc2-41c0-a585-b97ee30decdb" ;;
    *) return 1 ;;
  esac
}

if [[ -n "$CODE_REPOSITORY_SPECIFICATION_ID" ]]; then
  echo "Using CODE_REPOSITORY_SPECIFICATION_ID from environment: $CODE_REPOSITORY_SPECIFICATION_ID"
elif ! CODE_REPOSITORY_SPECIFICATION_ID=$(code_repository_specification_id "$CODE_REPOSITORY_PROVIDER"); then
  echo "ERROR: unknown code repository provider '$CODE_REPOSITORY_PROVIDER'. Known providers: github, gitlab, bitbucket, azure-devops."
  echo "If you use a custom provider specification, set CODE_REPOSITORY_SPECIFICATION_ID in the environment."
  exit 1
fi

CODE_REPOSITORY_LIST=$(np provider list --categories code-repository --nrn "$NRN" --format json)

CODE_REPOSITORY_MATCHES=$(echo "$CODE_REPOSITORY_LIST" \
  | jq --arg spec "$CODE_REPOSITORY_SPECIFICATION_ID" '[.results[] | select(.specification_id == $spec)]')

CODE_REPOSITORY_MATCH_COUNT=$(echo "$CODE_REPOSITORY_MATCHES" | jq 'length')

if [[ "$CODE_REPOSITORY_MATCH_COUNT" -eq 0 ]]; then
  echo "ERROR: no $CODE_REPOSITORY_PROVIDER code repository configuration (specification $CODE_REPOSITORY_SPECIFICATION_ID) found for NRN $NRN."
  echo "Configurations available for this NRN:"
  echo "$CODE_REPOSITORY_LIST" | jq -r '.results[] | "  - id=\(.id) specification_id=\(.specification_id)"'
  exit 1
fi

if [[ "$CODE_REPOSITORY_MATCH_COUNT" -gt 1 ]]; then
  echo "WARNING: found $CODE_REPOSITORY_MATCH_COUNT $CODE_REPOSITORY_PROVIDER code repository configurations for NRN $NRN, using the first one."
fi

CODE_REPOSITORY=$(echo "$CODE_REPOSITORY_MATCHES" | jq '.[0]')

echo "Using $CODE_REPOSITORY_PROVIDER code repository configuration: $(echo "$CODE_REPOSITORY" | jq -r '.id')"

CODE_REPOSITORY_SCRIPT_PATH="scripts/code-repo/$CODE_REPOSITORY_PROVIDER"

# The workflow runs $CODE_REPOSITORY_SCRIPT_PATH/<step> for every step, so a provider that is known
# but not implemented here would only fail once the workflow is already running.
if [[ ! -d "$CURRENT_DIR/$CODE_REPOSITORY_PROVIDER" ]]; then
  echo "ERROR: code repository provider '$CODE_REPOSITORY_PROVIDER' is not implemented in this repository yet ($CODE_REPOSITORY_SCRIPT_PATH not found)."
  exit 1
fi

# GitLab names this property access.default_collaborators, GitHub names it access.collaborators.
CODE_REPOSITORY_COLLABORATORS=$(echo "$CODE_REPOSITORY" \
  | jq '.attributes.access.default_collaborators // .attributes.access.collaborators // []')

export CODE_REPOSITORY_STRATEGY

export REPOSITORY_URL
export REPOSITORY_NAME

export CODE_REPOSITORY
export CODE_REPOSITORY_SCRIPT_PATH
export CODE_REPOSITORY_COLLABORATORS

np service workflow exec --workflow workflows/create_code_repository.yaml