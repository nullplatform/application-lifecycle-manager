# Copy to terraform.tfvars and fill in. NEVER commit terraform.tfvars.
#
# Requirements on PATH: tofu, gomplate and jq (the module renders the template
# through `data "external"` running gomplate).
# Authentication: the nullplatform provider reads NULLPLATFORM_API_KEY from the
# environment, so export it as well as setting np_api_key here.
#
# The module fetches the template over HTTP from
# "${repository_spec}/${repository_spec_branch}/${template_path}", so the branch
# below must be pushed before running apply.

nrn        = "organization=acme-1255165411:account=prod-95118862"
np_api_key = "REPLACE_ME"

# Publish the specification globally so no customer has to install it.
extra_visible_to_nrns = ["organization=*"]

# The branch the template is served from. Point it at main once this is merged.
repository_spec_branch = "feat/bitbucket-code-repo"
