#!/bin/bash
#
# Shared Bitbucket Cloud REST helpers. Sourced by the step scripts in this
# directory; the leading underscore marks it as "not a workflow step".
#
# IMPORTANT -- every script in this repository is SOURCED by
# `np service workflow exec`, not executed. (Proof: gitlab/create_repository
# uses a bare top-level `return`, and none of these files carry an executable
# bit.) Consequences:
#
#   * NEVER `set -euo pipefail` here. It would leak into the workflow shell and
#     silently change the behaviour of every later step.
#   * `exit 1` aborts the sourcing shell -- that IS how a step fails the
#     workflow, and entrypoint then reports "failed" back to nullplatform.
#   * `return` skips the rest of a step without failing the workflow.
#
# AUTH: nullplatform authenticates to Bitbucket Cloud with a single dedicated
# bot user's Atlassian API token, using HTTP Basic (email:api_token). This is the
# ONLY credential that can enable Bitbucket Pipelines -- an OAuth app (2LO) is
# refused there with a permanent 403, and a workspace access token fails the same
# 2SV check (both validated live). build_context resolves the email + token and
# exports them; every REST call here sends them as Basic auth, and git transport
# uses the username `x-bitbucket-api-token-auth` with the token as the password.

# bb_api METHOD PATH [BODY]
#
# Calls the Bitbucket REST API and sets BB_HTTP_CODE and BB_BODY. It never
# fails: every caller branches on the status code, because for Bitbucket the
# code is the meaning (404 = "free" on one endpoint, "never enabled" on
# another; 409 = "exists"; 401 != "missing").
bb_api() {
  local method="$1"
  local path="$2"
  local body="${3:-}"

  local tmp cfg body_file
  tmp=$(mktemp)
  cfg=$(mktemp)
  body_file=""

  chmod 600 "$cfg"

  # The credential goes in a 0600 config file, NEVER on the command line: argv is
  # world-readable through ps and /proc/<pid>/cmdline for as long as curl runs,
  # and monitoring agents log full command lines. An unquoted curl config value is
  # taken literally to end-of-line, so the token needs no escaping.
  printf 'user = %s:%s\n' "$BITBUCKET_EMAIL" "$BITBUCKET_API_TOKEN" > "$cfg"

  local args=(
    -s
    -o "$tmp"
    -w '%{http_code}'
    -X "$method"
    --config "$cfg"
    -H "Content-Type: application/json"
  )

  if [[ -n "$body" ]]; then
    # create_secrets sends the nullplatform CI api key in the body, so the body
    # has to stay off argv for the same reason.
    body_file=$(mktemp)
    chmod 600 "$body_file"
    printf '%s' "$body" > "$body_file"
    args+=(--data "@$body_file")
  fi

  local attempt=1
  local delay="${BB_RETRY_DELAY:-2}"
  local max="${BB_MAX_ATTEMPTS:-3}"

  while true; do
    # BB_HTTP_CODE and BB_BODY are the outputs of bb_api: they are read by the
    # step scripts that source this file, so they are not unused here.
    # shellcheck disable=SC2034
    BB_HTTP_CODE=$(curl "${args[@]}" "${BITBUCKET_API_BASE}${path}")
    # shellcheck disable=SC2034
    BB_BODY=$(cat "$tmp")

    if [[ "$attempt" -ge "$max" ]]; then
      break
    fi

    # 429 is Bitbucket's throttle and 5xx is transient. Everything else is a
    # decision only the caller can make, on the code itself.
    case "$BB_HTTP_CODE" in
      429 | 500 | 502 | 503 | 504)
        echo "Bitbucket returned HTTP $BB_HTTP_CODE for $method $path, retrying in ${delay}s"
        sleep "$delay"
        delay=$((delay * 2))
        attempt=$((attempt + 1))
        ;;
      *)
        break
        ;;
    esac
  done

  rm -f "$tmp" "$cfg"

  if [[ -n "$body_file" ]]; then
    rm -f "$body_file"
  fi
}

# bb_api_values METHOD PATH
#
# Walks Bitbucket's `next` pagination and sets BB_VALUES to ONE json array holding
# every `.values` entry. Bitbucket caps pagelen at 100, and a repository can hold
# more variables (or a workspace more members) than that, so a single page is
# never a safe assumption. BB_HTTP_CODE is left at the first non-200 code seen.
bb_api_values() {
  local method="$1"
  local path="$2"

  # shellcheck disable=SC2034
  BB_VALUES="[]"

  local next_path="$path"

  while [[ -n "$next_path" ]]; do
    bb_api "$method" "$next_path"

    if [[ "$BB_HTTP_CODE" != "200" ]]; then
      return
    fi

    # shellcheck disable=SC2034
    BB_VALUES=$(jq -nc --argjson acc "$BB_VALUES" --argjson page "$BB_BODY" \
      '$acc + ($page.values // [])')

    # `next` is an absolute URL; bb_api takes a path relative to the API base.
    next_path=$(echo "$BB_BODY" | jq -r --arg base "$BITBUCKET_API_BASE" \
      'if .next then (.next | sub("^" + $base; "")) else "" end')
  done
}

# bb_encode_uuid VALUE
#
# Bitbucket returns UUIDs with LITERAL braces -- {9484702e-...} -- and they must
# be percent-encoded before use as a path parameter.
bb_encode_uuid() {
  local value="$1"

  value="${value//\{/%7B}"
  value="${value//\}/%7D}"

  printf '%s' "$value"
}

# bb_resolve_or_fail VAR JQ_PATH ERROR_MESSAGE
#
# Resolves a non-secret setup value: the environment first (that is how ALM
# overrides the platform), then the provider record, then fail. Sets VAR in the
# caller's scope.
#
# Only for values whose absence is fatal and whose value is safe to log.
# installation_url defaults instead of failing, and api_token must never be
# echoed, so both stay written out in build_context.
bb_resolve_or_fail() {
  local var="$1"
  local jq_path="$2"
  local message="$3"

  local value="${!var:-}"

  if [[ -n "$value" ]]; then
    echo "Using $var from environment: $value"
  else
    value=$(echo "$CODE_REPOSITORY" | jq -r "${jq_path} // empty")
    echo "No $var in environment, using value from platform: $value"
  fi

  # Trim surrounding whitespace. A value pasted into the provider form with a
  # stray space is otherwise interpolated straight into a URL, and Bitbucket
  # answers with a code that says nothing about the real cause.
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"

  if [[ -z "$value" ]]; then
    bb_fail "$message"
  fi

  printf -v "$var" '%s' "$value"
}

# bb_urlencode VALUE
#
# Percent-encodes a value for use as a single path segment. Group slugs can carry
# spaces and other characters that must not reach the URL raw.
bb_urlencode() {
  jq -rn --arg value "$1" '$value | @uri'
}

# bb_resolve_principal ID
#
# Sets BB_PRINCIPAL to a path-ready Bitbucket user identifier and returns 0, or
# sets BB_RESOLVE_ERROR and returns 1. Both are globals rather than stdout: the
# caller has to be able to PRINT the reason, and stdout here is the return
# channel. Bitbucket addresses users by account_id or UUID only -- usernames were
# removed for GDPR -- but the platform stores the same collaborator ids for every
# provider, so a nickname has to be looked up.
bb_resolve_principal() {
  local id="$1"

  # shellcheck disable=SC2034
  BB_PRINCIPAL=""
  # shellcheck disable=SC2034
  BB_RESOLVE_ERROR=""

  # Already addressable: {uuid} or an Atlassian account_id (712020:uuid).
  if [[ "$id" == \{*\} || "$id" == *:* ]]; then
    BB_PRINCIPAL=$(bb_encode_uuid "$id")
    return 0
  fi

  if [[ "$id" == *@* ]]; then
    BB_RESOLVE_ERROR="Error: collaborator '$id' cannot be resolved from an email address: Bitbucket removed emails from its API for GDPR. Configure the Atlassian account_id or the workspace nickname instead."
    return 1
  fi

  bb_api_values GET "/workspaces/${BITBUCKET_WORKSPACE}/members?pagelen=100"

  if [[ "$BB_HTTP_CODE" != "200" ]]; then
    BB_RESOLVE_ERROR="Error: could not list the members of workspace '$BITBUCKET_WORKSPACE' to resolve collaborator '$id' (HTTP $BB_HTTP_CODE): $BB_BODY"
    return 1
  fi

  local account_id
  account_id=$(echo "$BB_VALUES" | jq -r --arg nickname "$id" \
    '.[]? | select(.user.nickname == $nickname) | .user.account_id // empty' | head -1)

  if [[ -z "$account_id" ]]; then
    # shellcheck disable=SC2034
    BB_RESOLVE_ERROR="Error: collaborator '$id' is not a member of the '$BITBUCKET_WORKSPACE' workspace: no member has that nickname."
    return 1
  fi

  # shellcheck disable=SC2034
  BB_PRINCIPAL=$(bb_urlencode "$account_id")
}

# bb_scrub
#
# stdin filter that redacts the API token. git prints credentialed remote URLs
# verbatim on failure, so every byte of git output goes through this. (The bot
# email is the Basic-auth username and the git URL's userinfo is the fixed
# literal `x-bitbucket-api-token-auth`; the token is the only secret.)
bb_scrub() {
  if [[ -z "${BITBUCKET_API_TOKEN:-}" ]]; then
    cat
    return
  fi

  local escaped
  # Escape regex metacharacters (including /) so any token value is literal.
  escaped=$(printf '%s' "$BITBUCKET_API_TOKEN" | sed -e 's/[]\/$*.^[]/\\&/g')

  sed -e "s/${escaped}/***/g"
}

# bb_git ARGS...
#
# Runs git with the terminal prompt disabled, scrubbing the token out of its
# output, and returns GIT's exit status -- not sed's. (A naive
# `git ... | bb_scrub` would always look successful, because a pipeline's status
# is its LAST command. We cannot use `set -o pipefail` to fix that: see the
# header.)
bb_git() {
  local output
  local status

  # GIT_ALLOW_PROTOCOL is the belt to the TEMPLATE_URL check's braces in
  # create_repository: even if a crafted URL ever slipped past that string check,
  # git itself refuses any transport other than https. It covers submodule URLs
  # inside a cloned template too, which the string check never sees.
  output=$(GIT_TERMINAL_PROMPT=0 GIT_ALLOW_PROTOCOL=https git "$@" 2>&1)
  status=$?

  # Only on FAILURE. git's chatter -- clone progress, the init default-branch
  # hints, the file list of a commit -- is noise in the activity log, where the
  # reader wants to know which step is running and what broke. On failure it is the
  # whole diagnosis, so it goes out in full (scrubbed).
  if [[ "$status" -ne 0 && -n "$output" ]]; then
    printf '%s\n' "$output" | bb_scrub
  fi

  return $status
}

# bb_git_authed ARGS...
#
# bb_git with the Bitbucket credential injected through git's env-based config
# (GIT_CONFIG_COUNT, git >= 2.31) instead of URL userinfo. Same reason as bb_api's
# config file: argv is world-readable, the environment is not. Callers therefore
# pass a CLEAN https URL, with no `user:pass@` in it.
#
# For an Atlassian API token the git username MUST be the literal string
# 'x-bitbucket-api-token-auth' ('x-token-auth' is for OAuth tokens and fails).
bb_git_authed() {
  local basic

  basic=$(printf '%s:%s' 'x-bitbucket-api-token-auth' "$BITBUCKET_API_TOKEN" | base64 | tr -d '\n')

  GIT_CONFIG_COUNT=1 \
  GIT_CONFIG_KEY_0="http.${BITBUCKET_INSTALLATION_URL}/.extraHeader" \
  GIT_CONFIG_VALUE_0="Authorization: Basic ${basic}" \
    bb_git "$@"
}

# bb_fail MESSAGE...
bb_fail() {
  # stdout, NOT stderr. entrypoint captures the workflow's stdout
  # (`logs=$(np service workflow exec ...)`) and forwards it to nullplatform;
  # anything on stderr never reaches the operator, who then sees only
  # "error: exit status 1". This is why the gitlab and github steps report with a
  # plain echo.
  echo "Error: $*"
  exit 1
}
