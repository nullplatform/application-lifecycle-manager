#!/bin/bash

CURRENT_DIR=$(dirname "${BASH_SOURCE[0]}")

# Three origins, in this order:
#
#   environment  >  secret  >  provider record on the platform
#
# The environment is the operator's deliberate choice and the secret is
# deliberate too, while the provider record is a shared default that is often
# stale -- typically managed by someone else's terraform and pointing at whatever
# App was installed first. So the secret is read BEFORE the provider record is
# consulted, and the record only fills what is still empty afterwards.
#
# Reading the secret first also costs nothing when it is not configured.

if [[ -n "$GITHUB_ACCOUNT" ]]; then
  echo "Using GITHUB_ACCOUNT from environment: $GITHUB_ACCOUNT"
else
  GITHUB_ACCOUNT=$(echo "$CODE_REPOSITORY" | jq -r '.attributes.setup.organization // empty')
  echo "No GITHUB_ACCOUNT in environment, using value from platform: $GITHUB_ACCOUNT"
fi

# Needs the account, because the secret id is templated with it.
# shellcheck source=scripts/code-repo/github/resolve_app_credentials
source "$CURRENT_DIR/resolve_app_credentials"

if [[ -n "$GITHUB_INSTALLATION_ID" ]]; then
  echo "Using GITHUB_INSTALLATION_ID: $GITHUB_INSTALLATION_ID"
else
  GITHUB_INSTALLATION_ID=$(echo "$CODE_REPOSITORY" | jq -r '.attributes.setup.installation_id // empty')
  echo "No GITHUB_INSTALLATION_ID in the environment or the secret, using value from platform: $GITHUB_INSTALLATION_ID"
fi

# Two different origins, so two different messages. The App credentials never
# come from the platform's provider record -- pointing someone at CODE_REPOSITORY
# to find a private key sends them to a place that will never hold one.
for var in GITHUB_APP_ID GITHUB_PRIVATE_KEY; do
  if [[ -z "${!var}" ]]; then
    echo "ERROR: $var is required for the GitHub code provider. Set it in the agent's environment, or supply it through GITHUB_APP_SECRET_ID."
    exit 1
  fi
done

for var in GITHUB_INSTALLATION_ID GITHUB_ACCOUNT; do
  if [[ -z "${!var}" ]]; then
    echo "ERROR: $var is not set and could not be resolved from CODE_REPOSITORY."
    exit 1
  fi
done

# mise first, release tarball if that fails. See the header of install_gh for why
# the fallback exists.
# shellcheck source=scripts/code-repo/github/install_gh
source "$CURRENT_DIR/install_gh"

# The JWT is built with python3 because the agent image ships no openssl binary, and openssl is
# available neither through mise nor through the image's apk index.
if ! command -v python3 >/dev/null 2>&1; then
  echo "ERROR: python3 is required to sign the GitHub App JWT but is not available in this environment."
  exit 1
fi

JWT=$(python3 "$CURRENT_DIR/sign_app_jwt.py")

if [[ -z "$JWT" ]]; then
  echo "ERROR: failed to build the GitHub App JWT."
  exit 1
fi

TOKEN_RESPONSE=$(curl -s -X POST \
  -H "Authorization: Bearer $JWT" \
  -H "Accept: application/vnd.github+json" \
  "https://api.github.com/app/installations/$GITHUB_INSTALLATION_ID/access_tokens")

GH_TOKEN=$(echo "$TOKEN_RESPONSE" | jq -r '.token // empty')

if [[ -z "$GH_TOKEN" ]]; then
  echo "ERROR: could not obtain a GitHub App installation token:"
  echo "$TOKEN_RESPONSE" | jq . 2>/dev/null || echo "$TOKEN_RESPONSE"
  exit 1
fi

echo "Obtained GitHub App installation token for account: $GITHUB_ACCOUNT"

export GH_TOKEN
export GITHUB_ACCOUNT
