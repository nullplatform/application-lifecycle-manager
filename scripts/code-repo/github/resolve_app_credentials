#!/bin/bash
#
# Optionally loads the GitHub App's credentials from a secrets store instead of
# the agent's environment.
#
# Why. Of the three values the App needs, only the private key is really secret,
# and in the environment it travels through the terraform state, the Helm values
# and every `kubectl describe`. Rotating it means an apply and a pod restart,
# which also freezes any application being created at that moment. Read from a
# secrets store it is none of those things, and the read is auditable.
#
# Opt-in: without GITHUB_APP_SECRET_ID this does nothing and the credentials come
# from the environment exactly as before.
#
#   GITHUB_APP_SECRET_ID    the secret to read. "${GITHUB_ACCOUNT}" in it is
#                           replaced by the organization, so one agent can serve
#                           several GitHub orgs -- adding one is a new secret,
#                           not a new deployment.
#   GITHUB_APP_SECRET_STORE "aws" (default). The only one implemented today; the
#                           name exists so adding Key Vault or GCP Secret Manager
#                           does not change the contract.
#
# The secret holds a JSON object. Every key is optional and only fills a value
# the environment did not already provide, so the private key can live here while
# the installation id keeps coming from the nullplatform provider:
#
#   { "app_id": "...", "installation_id": "...", "private_key": "-----BEGIN ..." }
#
# Sourced, like every step here. Nothing it reads is ever echoed: these messages
# are shown to the developer in the console.

if [[ -z "${GITHUB_APP_SECRET_ID:-}" ]]; then
  return 0
fi

GITHUB_APP_SECRET_STORE="${GITHUB_APP_SECRET_STORE:-aws}"

if [[ "$GITHUB_APP_SECRET_STORE" != "aws" ]]; then
  echo "ERROR: GITHUB_APP_SECRET_STORE '$GITHUB_APP_SECRET_STORE' is not supported. Only 'aws' is implemented."
  exit 1
fi

if ! command -v aws >/dev/null 2>&1; then
  echo "ERROR: GITHUB_APP_SECRET_ID is set but the aws CLI is not available on this host."
  exit 1
fi

# Only this placeholder is expanded, deliberately: running the id through eval
# would let a provider record reach a shell.
GITHUB_APP_SECRET_RESOLVED_ID="${GITHUB_APP_SECRET_ID//\$\{GITHUB_ACCOUNT\}/$GITHUB_ACCOUNT}"

echo "Reading the GitHub App credentials from secret: $GITHUB_APP_SECRET_RESOLVED_ID"

if ! GITHUB_APP_SECRET_JSON=$(aws secretsmanager get-secret-value \
  --secret-id "$GITHUB_APP_SECRET_RESOLVED_ID" \
  --query SecretString --output text 2>&1); then
  echo "ERROR: could not read the secret '$GITHUB_APP_SECRET_RESOLVED_ID': $GITHUB_APP_SECRET_JSON"
  exit 1
fi

if ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$GITHUB_APP_SECRET_JSON"; then
  echo "ERROR: the secret '$GITHUB_APP_SECRET_RESOLVED_ID' does not hold a JSON object."
  exit 1
fi

# Each key fills only what the environment left empty, so a deployment can keep
# the installation id on the platform and the key in the store.
github_credential_from_secret() {
  local var="$1" key="$2" value

  if [[ -n "${!var:-}" ]]; then
    return 0
  fi

  value=$(jq -r --arg k "$key" '.[$k] // empty' <<<"$GITHUB_APP_SECRET_JSON")

  if [[ -z "$value" ]]; then
    return 0
  fi

  export "$var=$value"
  echo "  $var loaded from the secret"
}

github_credential_from_secret GITHUB_APP_ID          app_id
github_credential_from_secret GITHUB_INSTALLATION_ID installation_id
github_credential_from_secret GITHUB_PRIVATE_KEY     private_key

unset GITHUB_APP_SECRET_JSON
