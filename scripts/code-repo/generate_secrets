#!/bin/bash
CI_ROLE_ID=1855672260
# TODO(federico.maleh) missing support for mono repo
# TODO(federico.maleh) missing support for extra secrets
# TODO(federico.maleh) missing support for extra roles in api key
  
API_KEY_NAME="ci-$NAMESPACE_SLUG-$NAMESPACE_ID-$APPLICATION_SLUG-$APPLICATION_ID"

echo "Creating api key for ci: $API_KEY_NAME"

API_KEY_BODY=$(jq -nc \
  --arg name "$API_KEY_NAME" \
  --arg nrn "$NRN" \
  --argjson role_id "$CI_ROLE_ID" \
  '{name: $name, grants: [{nrn: $nrn, role_id: $role_id}], tags: [{key: "ci", value: true}], internal: true}')

# Creating an api key needs a credential that is allowed to create api keys.
# The agent's own key is not: its canonical grants (controlplane:agent,
# developer, ops, secops, secrets-reader) do not include that permission, so
# this call returns 401 and every application:create fails here — which also
# stops the after-hooks that depend on the key this step produces.
#
# When NP_API_KEY_CREATOR is set, use it for THIS CALL ONLY. NP_TOKEN wins over
# both --api-key and NULLPLATFORM_API_KEY, so it has to be unset for the
# override to take effect, and restored right after: everything downstream
# still authenticates as the agent.
if [[ -n "${NP_API_KEY_CREATOR:-}" ]]; then
  _previous_np_token="${NP_TOKEN:-}"
  unset NP_TOKEN
  export NP_API_KEY="$NP_API_KEY_CREATOR"
  export NULLPLATFORM_API_KEY="$NP_API_KEY_CREATOR"

  API_KEY_RESPONSE=$(np api-key create --format json --body "$API_KEY_BODY")

  export NP_TOKEN="$_previous_np_token"
  unset NP_API_KEY NULLPLATFORM_API_KEY _previous_np_token
else
  API_KEY_RESPONSE=$(np api-key create --format json --body "$API_KEY_BODY")
fi

API_KEY=$(echo "$API_KEY_RESPONSE" | jq -r '.api_key // empty')
API_KEY_ID=$(echo "$API_KEY_RESPONSE" | jq -r '.id // empty')

if [[ -n "$API_KEY_ID" && -n "$API_KEY" ]]; then
  echo "Created ci api key: $API_KEY_ID"
else
  echo "Error creating ci api key"
  echo "$API_KEY_RESPONSE" | jq

  exit 1
fi

# CI templates authenticate with the nullplatform CLI, which reads the API key from
# NULLPLATFORM_API_KEY, so every provider stores it under that name.
API_KEY_SECRET_NAME="NULLPLATFORM_API_KEY"

echo "Storing the ci api key as secret: $API_KEY_SECRET_NAME"

CODE_REPOSITORY_SECRETS=$(jq -nc --arg name "$API_KEY_SECRET_NAME" --arg value "$API_KEY" '{($name): $value}')

export CODE_REPOSITORY_SECRETS