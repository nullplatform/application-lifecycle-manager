#!/bin/bash
#
# Derives the repository name from what the hook knows about the application --
# the metadata the developer filled in, its namespace, its account -- so the
# repository is born with the right name.
#
# Opt-in: without REPOSITORY_NAME_RULE the step does nothing and the dispatcher
# keeps deriving the name from the application's repository_url.
#
# Like every step here this file is SOURCED into the workflow's shared shell, so
# a no-op must `return` and never `exit` -- an `exit 0` would end that shell and
# silently skip every later step, repository creation included.

# The rule is JSON, so it carries double quotes, and not every deployment can put
# those in an environment variable -- the nullplatform agent tofu module renders
# `KEY: "${value}"` straight into its Helm values with no escaping, and the YAML
# breaks before the agent starts. REPOSITORY_NAME_RULE_B64 carries the same
# document with nothing to escape. The plain variable wins when both are set.
RESOLVE_RULE_SOURCE="REPOSITORY_NAME_RULE"

if [[ -z "$REPOSITORY_NAME_RULE" && -n "${REPOSITORY_NAME_RULE_B64:-}" ]]; then
  RESOLVE_RULE_SOURCE="REPOSITORY_NAME_RULE_B64"

  # base64 implementations disagree about junk, and they disagree differently:
  # busybox exits 0 on input the others reject, macOS exits 0 on input GNU
  # rejects, and all three can emit nothing at all. So the exit status is not the
  # check -- an empty decode is. The variable was set, so something was meant to
  # be there; nothing came out, so it is corrupt. Without this the empty result
  # falls through to the "not configured" branch below and the repository quietly
  # takes the console's default name.
  REPOSITORY_NAME_RULE=$(printf '%s' "$REPOSITORY_NAME_RULE_B64" | base64 -d 2>/dev/null)

  if [[ -z "$REPOSITORY_NAME_RULE" ]]; then
    echo "ERROR: REPOSITORY_NAME_RULE_B64 is set but decodes to nothing. Check the base64 is intact and single-line."
    exit 1
  fi
fi

if [[ -z "$REPOSITORY_NAME_RULE" ]]; then
  echo "No REPOSITORY_NAME_RULE configured, leaving the repository name to the application's repository_url"
  return 0
fi

# A rule that is not valid JSON would otherwise surface as a confusing "the
# metadata field '' is required", because every jq lookup against it comes back
# empty.
if ! jq -e . >/dev/null 2>&1 <<<"$REPOSITORY_NAME_RULE"; then
  if [[ "$RESOLVE_RULE_SOURCE" == "REPOSITORY_NAME_RULE_B64" ]]; then
    # Decoded junk is binary; printing it would corrupt the hook's messages.
    echo "ERROR: REPOSITORY_NAME_RULE_B64 did not decode to valid JSON. Check the base64 is intact and single-line."
  else
    echo "ERROR: REPOSITORY_NAME_RULE is not valid JSON: $REPOSITORY_NAME_RULE"
  fi
  exit 1
fi

# Only a repository being created gets a derived name. An import already has one,
# and pointing it somewhere else would send it at a repository that does not
# exist.
#
# The dispatcher has already settled this, so ask it rather than working it out
# again from the application: it also applies the default template, and an
# installation that removed the template chooser from its console produces
# applications with no template at all.
#
# And not by the presence of a repository_url: the console fills that in before
# the hook runs, defaulting to <namespace-slug>-<application-slug>, so every
# application arrives here already carrying one.
if [[ "$CODE_REPOSITORY_STRATEGY" != "create" ]]; then
  RESOLVE_EXISTING_URL=$(jq -r '.repository_url // empty' <<<"$APPLICATION")
  echo "Strategy is '${CODE_REPOSITORY_STRATEGY:-unset}', not 'create'; keeping the application's repository_url (${RESOLVE_EXISTING_URL:-unknown}) instead of deriving a name"
  return 0
fi

# Slugify: transliterate, lowercase, every run of non-alphanumerics to one
# hyphen, edges trimmed.
#
# The transliteration is not cosmetic. Free-text metadata is typed by people, and
# these fields carry ñ and accents; the slug keeps only [a-z0-9], and a multi-byte
# character is several bytes, so "Cañería" would come out as "ca-er-a".
#
# One s/// per character, and deliberately not a y/// or a bracket expression.
# y/// is byte-wise in busybox sed, which the agent image ships, and corrupts
# multi-byte input outright. A bracket expression like [áàäâã] is byte-wise under
# GNU sed in the C locale, which is what CI runs: each byte of a two-byte
# character is replaced separately, so "Cañería" comes out "caa-eraia". Matching
# the whole character as a literal string is the only form that behaves the same
# on all three. `tr` for the case fold rather than ${v,,} because that bash is not
# guaranteed to be 4.x.
resolve_slug() {
  printf '%s' "$1" \
    | sed \
    -e 's/á/a/g; s/à/a/g; s/ä/a/g; s/â/a/g; s/ã/a/g; s/å/a/g' \
    -e 's/Á/A/g; s/À/A/g; s/Ä/A/g; s/Â/A/g; s/Ã/A/g; s/Å/A/g' \
    -e 's/é/e/g; s/è/e/g; s/ë/e/g; s/ê/e/g' \
    -e 's/É/E/g; s/È/E/g; s/Ë/E/g; s/Ê/E/g' \
    -e 's/í/i/g; s/ì/i/g; s/ï/i/g; s/î/i/g' \
    -e 's/Í/I/g; s/Ì/I/g; s/Ï/I/g; s/Î/I/g' \
    -e 's/ó/o/g; s/ò/o/g; s/ö/o/g; s/ô/o/g; s/õ/o/g' \
    -e 's/Ó/O/g; s/Ò/O/g; s/Ö/O/g; s/Ô/O/g; s/Õ/O/g' \
    -e 's/ú/u/g; s/ù/u/g; s/ü/u/g; s/û/u/g' \
    -e 's/Ú/U/g; s/Ù/U/g; s/Ü/U/g; s/Û/U/g' \
    -e 's/ñ/n/g' \
    -e 's/Ñ/N/g' \
    -e 's/ç/c/g' \
    -e 's/Ç/C/g' \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

# A value can be present and still be unusable. It applies to every placeholder
# the pattern expands, so it lives here.
resolve_reject_unusable() {
  local field="$1" value="$2" segment="$3"

  # sed works line by line, so a newline is never one of the "non-alphanumerics"
  # the slug collapses: it survives into the name and reaches the provider, which
  # rejects it with a message about repository creation -- the message this whole
  # validation exists to replace.
  if [[ "$value" == *[[:cntrl:]]* ]]; then
    echo "ERROR: the value at '$field' contains a control character, so it cannot become part of a repository name."
    exit 1
  fi

  # The transliteration covers latin diacritics; a value in another script, or one
  # that is all punctuation, slugs to nothing and used to leave an empty segment.
  if [[ -z "$segment" ]]; then
    echo "ERROR: the value at '$field' is '$value', which leaves nothing usable in a repository name."
    exit 1
  fi
}

# Every path in the rule is absolute against the workflow's shared $CONTEXT --
# `.application.metadata.application.domain`, `.namespace.slug` -- so a rule can
# name anything the hook already knows, not just the application's metadata.
#
# scripts/base_context builds it, and checks it, before any step runs.
RESOLVE_CONTEXT="$CONTEXT"

# resolve_path_value PATH -- the scalar the context carries at PATH, empty when
# the path leads nowhere.
#
# getpath over a parsed path rather than `jq "$path"`: the rule is configuration,
# and evaluating it as a jq program would make every naming rule a place to run
# arbitrary jq against the hook's context. It also keeps the failure modes down
# to one -- a path that leads nowhere -- instead of jq syntax errors surfacing
# mid-hook.
resolve_path_value() {
  jq -r --arg p "$1" '
    ($p | ltrimstr(".") | split(".")) as $parts
    | getpath($parts)
    | if . == null then empty else tostring end
  ' <<<"$RESOLVE_CONTEXT" 2>/dev/null
}

# resolve_path_type PATH -- the JSON type at PATH, so a value that cannot be a
# segment is caught before it is stringified.
resolve_path_type() {
  jq -r --arg p "$1" '
    ($p | ltrimstr(".") | split(".")) as $parts
    | getpath($parts)
    | type
  ' <<<"$RESOLVE_CONTEXT" 2>/dev/null
}

# resolve_condition_holds PATH EXPECTED_JSON -- whether the context carries the
# expected value at PATH.
#
# Two numbers are compared as numbers: jq 1.7 renders `3.0 | tostring` as "3.0",
# so a rule saying 3 used to fall through against a context carrying 3.0. Every
# other pair is compared as strings, which keeps a rule's 3 matching the "3" a
# metadata form stores, and an absent path reads as "" -- as it does everywhere
# else in this step.
resolve_condition_holds() {
  jq -e --arg p "$1" --argjson want "$2" '
    (($p | ltrimstr(".") | split(".")) as $parts | getpath($parts)) as $got
    | if ($got | type) == "number" and ($want | type) == "number" then
        $got == $want
      else
        (if $got == null then "" else $got | tostring end) == ($want | tostring)
      end
  ' >/dev/null <<<"$RESOLVE_CONTEXT" 2>/dev/null
}

# A path is a dotted path and nothing else. Held in one variable because both
# sides need it and they used to disagree: the placeholders were checked against
# it and the condition keys were not, so `application.metadata.x` -- no leading
# dot -- worked in a condition and was refused in the pattern. `ltrimstr(".")` is
# a no-op without the dot and `split(".")` still yields the right parts, which is
# why the condition side never noticed.
#
# The same string is handed to jq's test() below. It means the same thing in both:
# no alternation, no backreference, nothing the two flavours read differently.
RESOLVE_PATH_RE='^(\.[A-Za-z0-9_-]+)+$'

# The rule is written by whoever configures the agent, and the developer creating
# an application cannot see it. So every shape problem in it has to say the rule
# is wrong, rather than blame a value the developer did fill in.
RESOLVE_RULE_TYPE=$(jq -r 'type' <<<"$REPOSITORY_NAME_RULE")

if [[ "$RESOLVE_RULE_TYPE" != "object" ]]; then
  # A JSON string is the shape `jsonencode(file("rules.json"))` produces in
  # terraform: the document arrives quoted, and `jq -e .` accepts it, so the
  # mistake used to surface much later as a jq error about indexing a string.
  echo "ERROR: the naming rule is a $RESOLVE_RULE_TYPE, not an object."
  if [[ "$RESOLVE_RULE_TYPE" == "string" ]]; then
    echo "If it comes from terraform, pass the file as filebase64(\"rules.json\") in REPOSITORY_NAME_RULE_B64. jsonencode(file(...)) hands the document over as a quoted string, not as JSON."
  fi
  exit 1
fi

RESOLVE_BRANCHES_TYPE=$(jq -r '.branches | type' <<<"$REPOSITORY_NAME_RULE")

if [[ "$RESOLVE_BRANCHES_TYPE" != "array" ]]; then
  echo "ERROR: the naming rule's 'branches' is $RESOLVE_BRANCHES_TYPE, not a list of {condition, naming_pattern} entries."
  exit 1
fi

RESOLVE_BRANCH_COUNT=$(jq '.branches | length' <<<"$REPOSITORY_NAME_RULE")

if [[ "$RESOLVE_BRANCH_COUNT" -eq 0 ]]; then
  echo "ERROR: the naming rule's 'branches' is empty; it needs at least one entry with a naming_pattern."
  exit 1
fi

# One pass in jq rather than a loop in bash: it reports the first bad entry BY
# INDEX, which is what the operator needs to find it in a rule that is several
# branches long. jq's if/elif is lazy, so `.naming_pattern` is only reached on an
# entry already known to be an object.
#
# Every branch's placeholders are checked here, not just the winner's when it is
# expanded: otherwise a bad one loads without complaint and only fails when an
# application first matches that branch, inside the before-create hook.
RESOLVE_SHAPE_ERROR=$(jq -r --arg pathre "$RESOLVE_PATH_RE" '
  [ .branches
    | to_entries[]
    | .key as $i
    | .value as $b
    | if ($b | type) != "object" then
        "branch \($i) is a \($b | type); every branch has to be an object with a naming_pattern"
      elif ($b.naming_pattern | type) != "string" or ($b.naming_pattern | length) == 0 then
        "branch \($i) has no naming_pattern; every branch needs one, as a non-empty string"
      elif ($b | has("condition")) and (($b.condition | type) != "object") then
        "branch \($i) has a condition that is a \($b.condition | type); a condition is an object of path -> expected value"
      elif ((($b.condition // {}) | to_entries | map(select((.value | type) | . == "array" or . == "object")) | length) > 0) then
        "branch \($i) has a condition compared against a list or an object; only a single value can be compared"
      elif ((($b.condition // {}) | to_entries | map(select(.value == null)) | first) != null) then
        "branch \($i) compares a condition against null, which can never match: an absent path yields the empty string, not null. Only a string, a number or a boolean can be compared"
      elif ((($b.condition // {}) | keys_unsorted | map(select(test($pathre) | not)) | first) != null) then
        "branch \($i) has a condition on \(($b.condition | keys_unsorted | map(select(test($pathre) | not)) | first)), which is not a path a naming rule can use. A path is dotted, like .application.metadata.application.domain or .namespace.slug"
      elif ($b.naming_pattern | test("\\{[^}]*$")) then
        "branch \($i) has a naming_pattern with a \"{\" that is never closed: \($b.naming_pattern)"
      elif (([$b.naming_pattern | scan("\\{([^}]*)\\}")[0] | rtrimstr("?") | select(test($pathre) | not)] | first) != null) then
        "branch \($i) has a placeholder {\([$b.naming_pattern | scan("\\{([^}]*)\\}")[0] | rtrimstr("?") | select(test($pathre) | not)] | first)} in its naming_pattern, which is not a path a naming rule can use. A placeholder is a dotted path against the hook context, like {.application.metadata.application.domain} or {.namespace.slug}, with an optional trailing ?"
      else empty end
  ] | first // empty
' <<<"$REPOSITORY_NAME_RULE")

if [[ -n "$RESOLVE_SHAPE_ERROR" ]]; then
  echo "ERROR: $RESOLVE_SHAPE_ERROR. Check REPOSITORY_NAME_RULE on the agent."
  exit 1
fi

# Branches are tried in order and the first whose conditions all hold wins, so a
# branch with no condition matches anything and acts as the fallback -- which is
# only useful last, where it cannot shadow the ones after it.
RESOLVE_PATTERN=""
RESOLVE_MATCHED_INDEX=-1
resolve_index=0

while [[ "$resolve_index" -lt "$RESOLVE_BRANCH_COUNT" ]]; do
  resolve_matched=1

  # Process substitution, not a pipe: a pipe would run the loop in a subshell and
  # resolve_matched would come back unset on every branch that did not match.
  while read -r resolve_cond_path; do
    [[ -z "$resolve_cond_path" ]] && continue

    resolve_expected=$(jq -c --argjson i "$resolve_index" --arg k "$resolve_cond_path" \
      '.branches[$i].condition[$k]' <<<"$REPOSITORY_NAME_RULE")

    if ! resolve_condition_holds "$resolve_cond_path" "$resolve_expected"; then
      resolve_matched=0
      break
    fi
  done < <(jq -r --argjson i "$resolve_index" \
    '.branches[$i].condition // {} | keys_unsorted[]' <<<"$REPOSITORY_NAME_RULE")

  if [[ "$resolve_matched" -eq 1 ]]; then
    RESOLVE_MATCHED_INDEX="$resolve_index"
    RESOLVE_MATCHED_CONDITIONS=$(jq -r --argjson i "$resolve_index" \
      '.branches[$i].condition // {} | length' <<<"$REPOSITORY_NAME_RULE")
    RESOLVE_PATTERN=$(jq -r --argjson i "$resolve_index" \
      '.branches[$i].naming_pattern' <<<"$REPOSITORY_NAME_RULE")
    break
  fi

  resolve_index=$((resolve_index + 1))
done

# Without this the empty pattern expanded to an empty name, which was then
# reported as a success and used to create the repository.
if [[ "$RESOLVE_MATCHED_INDEX" -lt 0 ]]; then
  echo "ERROR: no branch in the naming rule matches this application, and there is no branch without a 'condition' to fall back to."
  echo "What the rule compared:"

  # Walked again rather than collected during the match: this only runs on the
  # way out, and it is the message that tells the operator whether the rule or
  # the metadata specification is the thing that moved.
  resolve_index=0
  while [[ "$resolve_index" -lt "$RESOLVE_BRANCH_COUNT" ]]; do
    while read -r resolve_cond_path; do
      [[ -z "$resolve_cond_path" ]] && continue

      resolve_expected=$(jq -r --argjson i "$resolve_index" --arg k "$resolve_cond_path" \
        '.branches[$i].condition[$k] | tostring' <<<"$REPOSITORY_NAME_RULE")

      echo "  branch $resolve_index: $resolve_cond_path is '$(resolve_path_value "$resolve_cond_path")', the rule wants '$resolve_expected'"
    done < <(jq -r --argjson i "$resolve_index" \
      '.branches[$i].condition // {} | keys_unsorted[]' <<<"$REPOSITORY_NAME_RULE")

    resolve_index=$((resolve_index + 1))
  done

  echo "Add a branch for this combination, or a branch with no 'condition' at the end of the list to catch everything else."
  exit 1
fi

# Said out loud because a condition whose path resolves to nothing does not fail
# -- the branch just does not match -- so a misspelt path falls through to the
# catch-all and the repository is created under the fallback name with nothing to
# show for it. The path is well formed, so no shape check catches it; naming the
# branch that won is what makes the fall-through visible in the hook messages.
if [[ "$RESOLVE_MATCHED_CONDITIONS" -eq 0 ]]; then
  echo "Naming rule: branch $RESOLVE_MATCHED_INDEX has no condition, so it matched as the fallback. Pattern: $RESOLVE_PATTERN"
else
  echo "Naming rule: branch $RESOLVE_MATCHED_INDEX matched on all $RESOLVE_MATCHED_CONDITIONS of its conditions. Pattern: $RESOLVE_PATTERN"
fi

# Expanded inline rather than through a helper: a helper that both echoes the
# name and reports a placeholder problem has to run in a command substitution,
# and there its error message is captured into the variable instead of reaching
# the log.
RESOLVE_NAME=""
resolve_rest="$RESOLVE_PATTERN"

while [[ "$resolve_rest" == *"{"* ]]; do
  RESOLVE_NAME="$RESOLVE_NAME${resolve_rest%%\{*}"
  resolve_rest="${resolve_rest#*\{}"

  # The shape pass above has already refused a "{" that is never closed and a
  # placeholder that is not a dotted path, so both trims below find their "}".
  resolve_placeholder="${resolve_rest%%\}*}"
  resolve_rest="${resolve_rest#*\}}"

  # A trailing "?" marks the placeholder optional. The wizard collects fields the
  # developer may leave blank, and a blank one has to leave no trace: no empty
  # segment, no doubled hyphen, no failure.
  resolve_optional=0
  if [[ "$resolve_placeholder" == *\? ]]; then
    resolve_optional=1
    resolve_placeholder="${resolve_placeholder%\?}"
  fi

  # Only scalars can become a path segment. jq renders an array or an object
  # across several lines, and those newlines used to end up inside the repository
  # name, which the provider then rejects with a message that mentions nothing
  # about the rule.
  resolve_kind=$(resolve_path_type "$resolve_placeholder")

  if [[ "$resolve_kind" == "array" || "$resolve_kind" == "object" ]]; then
    echo "ERROR: '$resolve_placeholder' holds an $resolve_kind; only a single value can become part of a repository name."
    exit 1
  fi

  resolve_value=$(resolve_path_value "$resolve_placeholder")
  resolve_segment=$(resolve_slug "$resolve_value")

  # Absent is what "optional" is about. Present but unusable is a different thing
  # and is always an error, optional or not -- skipping it would silently drop an
  # answer the developer gave.
  if [[ -n "$resolve_value" ]]; then
    resolve_reject_unusable "$resolve_placeholder" "$resolve_value" "$resolve_segment"
  elif [[ "$resolve_optional" -ne 1 ]]; then
    # A required placeholder that is missing would otherwise collapse into
    # 'net-app-issuance', one segment short and indistinguishable from a name
    # that was meant to look like that. Because this runs inside a before-create
    # hook, that name would be baked into an application nobody can trace back to
    # a repository. Fail loudly instead.
    echo "ERROR: '$resolve_placeholder' is required by the naming pattern but is empty or missing. Add a trailing '?' inside the placeholder if it is allowed to be blank."
    exit 1
  fi

  RESOLVE_NAME="$RESOLVE_NAME$resolve_segment"
done

RESOLVE_NAME="$RESOLVE_NAME$resolve_rest"

# Slugified once more over the assembled string. The separators in a pattern are
# literal text, so a placeholder that resolved to nothing leaves "--" behind and
# a pattern ending in a separator leaves a trailing hyphen; the slug collapses
# both. It is idempotent, so the segments slugified above pass through unchanged.
RESOLVE_NAME=$(resolve_slug "$RESOLVE_NAME")

# Every placeholder optional and every one of them blank leaves only separators,
# which slug to nothing. Each was individually allowed to vanish, so nothing
# failed on the way here, and the empty name used to be reported as derived and
# handed to the provider.
if [[ -z "$RESOLVE_NAME" ]]; then
  echo "ERROR: branch $RESOLVE_MATCHED_INDEX of the naming rule left nothing to name the repository with. Its naming pattern is '$RESOLVE_PATTERN' and every placeholder in it resolved to nothing; at least one of them has to be required."
  exit 1
fi


# The slug already guarantees GitHub's charset ([a-z0-9-]); the length is the
# part a free-text metadata field can still blow past. Failing here names the
# metadata, where the fix is; failing at the provider API does not.
if [[ "${#RESOLVE_NAME}" -gt 100 ]]; then
  echo "ERROR: the derived repository name is ${#RESOLVE_NAME} characters, over the 100 character limit: $RESOLVE_NAME"
  exit 1
fi

echo "Derived repository name: $RESOLVE_NAME"

REPOSITORY_NAME="$RESOLVE_NAME"

# Tells create_repository that the application does not know this URL yet, so it
# has to travel back through the hook's callback_body.
REPOSITORY_NAME_DERIVED="true"

export REPOSITORY_NAME
export REPOSITORY_NAME_DERIVED
