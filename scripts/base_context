#!/bin/bash

NRN=$(echo "$NP_ACTION_CONTEXT" | jq -r .notification.nrn)

ACCOUNT_ID=$(echo "$NRN" | sed -n 's/.*account=\([0-9]*\).*/\1/p')
NAMESPACE_ID=$(echo "$NRN" | sed -n 's/.*namespace=\([0-9]*\).*/\1/p')
APPLICATION_ID=$(echo "$NRN" | sed -n 's/.*application=\([0-9]*\).*/\1/p')

ACCOUNT=$(np account read --format json --id "$ACCOUNT_ID")

NAMESPACE=$(np namespace read --format json --id "$NAMESPACE_ID")

APPLICATION=$(np application read --format json --id "$APPLICATION_ID")

# Checked here, one by one, because every later step is entitled to assume CONTEXT
# is there and well formed. `np` reports a failed read on stderr and prints
# nothing on stdout, so an unchecked failure reached --argjson below as an empty
# string: jq failed, CONTEXT came out empty, and the steps that read it blamed
# whatever they happened to look up first. Named individually because the three
# documents are indistinguishable once merged.
#
# The id is in the message because an NRN that did not parse leaves it empty, and
# "read failed" alone sends the operator to the API instead of to the NRN.
base_context_require() {
  local label="$1" id="$2" document="$3"

  if ! jq -e . >/dev/null 2>&1 <<<"$document"; then
    echo "ERROR: could not read the $label (id '${id:-<empty>}') for NRN '${NRN:-<empty>}', so the hook context cannot be built. Response: ${document:-<empty>}"
    exit 1
  fi
}

base_context_require account "$ACCOUNT_ID" "$ACCOUNT"
base_context_require namespace "$NAMESPACE_ID" "$NAMESPACE"
base_context_require application "$APPLICATION_ID" "$APPLICATION"

APPLICATION_SLUG=$(echo "$APPLICATION" | jq -r .slug)
NAMESPACE_SLUG=$(echo "$NAMESPACE" | jq -r .slug)

CONTEXT=$(echo "$NP_ACTION_CONTEXT" | jq \
  --argjson namespace "$NAMESPACE" \
  --argjson application "$APPLICATION" \
  --argjson account "$ACCOUNT" \
  '.notification + {namespace: $namespace, application: $application, account: $account}')

# The three documents are checked above, but the merge itself can still come out
# empty: jq on an empty NP_ACTION_CONTEXT prints nothing and exits 0, and on a
# malformed one it fails with CONTEXT left empty. Later steps read CONTEXT with
# jq's errors swallowed -- a path leading nowhere reads as "absent" -- so an empty
# one would not fail there, it would quietly send the naming rule to its fallback.
#
# NP_ACTION_CONTEXT is not echoed: it carries the notification, callback url
# included, and the hook messages are visible to the developer.
if ! jq -e 'type == "object" and .application != null' >/dev/null 2>&1 <<<"$CONTEXT"; then
  if [[ -z "$NP_ACTION_CONTEXT" ]]; then
    echo "ERROR: NP_ACTION_CONTEXT is empty, so the hook context cannot be built."
  else
    echo "ERROR: NP_ACTION_CONTEXT is not a JSON object, so the hook context cannot be built."
  fi
  exit 1
fi

export ACCOUNT_ID

export NAMESPACE
export NAMESPACE_ID
export NAMESPACE_SLUG

export APPLICATION
export APPLICATION_ID
export APPLICATION_SLUG
export NRN
export CONTEXT
