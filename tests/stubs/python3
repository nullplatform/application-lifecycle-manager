#!/bin/bash
# `python3` stub: stands in for sign_app_jwt.py and for resolve_python's
# `-c` import probe, on the system python3 only -- mise's python is
# mise_python_stub in tests/lib.sh.
#
# The repository's tests deliberately need nothing but bash, curl and jq (see the
# header of tests/run), and signing a real JWT would pull in the `cryptography`
# package. So what these tests cover is ORCHESTRATION -- build_context reading
# the App credentials, minting the installation token, resolving the account,
# and resolve_python choosing an interpreter.
#
# sign_app_jwt.py itself is NOT covered by this suite, and nothing else covers it
# either. Proving it would need a live run against a real GitHub App, the way
# tests/smoke_bitbucket_live does for Bitbucket; that file does not exist yet.
#
# $PYTHON_STUB_FAIL makes the signing fail, for the path that must react to it.
# $PYTHON_STUB_NO_CRYPTO fails resolve_python's `-c` import probe, as on a python3
# without the package; $PYTHON_STUB_SILENT_FAIL fails it without a word.
#
# The probe passes only when it imports all three modules sign_app_jwt.py uses: a
# probe weakened back to `import cryptography` would let a python3 through that
# then cannot sign, and this is where that regression shows.

printf 'python3\t%s\n' "$*" >> "$BB_CALLS"

if [[ "$1" == "-c" ]]; then
  if [[ -n "$PYTHON_STUB_SILENT_FAIL" ]]; then
    exit 1
  fi
  if [[ -n "$PYTHON_STUB_NO_CRYPTO" ]]; then
    echo "ModuleNotFoundError: No module named 'cryptography'" >&2
    exit 1
  fi
  for module in hashes serialization padding; do
    if [[ "$2" != *"$module"* ]]; then
      echo "stub: the probe does not import '$module', which sign_app_jwt.py needs" >&2
      exit 1
    fi
  done
  exit 0
fi

if [[ -n "$PYTHON_STUB_FAIL" ]]; then
  echo "ERROR: GITHUB_PRIVATE_KEY is not a valid private key" >&2
  exit 1
fi

echo "header.payload.signature"
