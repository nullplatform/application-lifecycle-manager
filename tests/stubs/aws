#!/bin/bash
# `aws` CLI stub: records the invocation and returns a canned SecretString.
#
# The fixture is keyed by secret id, so a case can stub several secrets and assert
# which one was actually asked for -- the id is templated per organization, and
# picking the wrong one is the mistake worth catching.
#
# $AWS_STUB_FAIL makes the call fail, for the path that must react to a secret
# that cannot be read (missing, no permission, wrong region).

printf 'aws\t%s\n' "$*" >> "$BB_CALLS"

# `aws ecr <operation>` answers from that operation's ecr_fixture: stdout, stderr
# and exit code, so a case can fail a call the way the CLI does.
if [[ "$1" == "ecr" ]]; then
  op="$2"

  if [[ ! -f "$BB_FIXTURES/ecr_${op}.code" ]]; then
    echo "aws: no fixture for 'ecr $op'" >&2
    exit 255
  fi

  # stderr first: the CLI's warnings come before its JSON, which is what breaks a
  # parse that merges the two.
  cat "$BB_FIXTURES/ecr_${op}.stderr" >&2
  cat "$BB_FIXTURES/ecr_${op}.stdout"
  exit "$(cat "$BB_FIXTURES/ecr_${op}.code")"
fi

if [[ "$1 $2" == "sts assume-role" ]]; then
  if [[ -n "$AWS_STUB_STS_FAIL" ]]; then
    echo "An error occurred (AccessDenied) when calling the AssumeRole operation: not authorized to perform sts:AssumeRole" >&2
    exit 254
  fi

  sts_body='{"Credentials":{"AccessKeyId":"ASIASTUBKEY","SecretAccessKey":"stub-secret-key","SessionToken":"stub-session-token","Expiration":"2026-10-26T13:00:00Z"}}'
  printf '%s\n' "${AWS_STUB_STS_BODY:-$sts_body}"
  exit 0
fi

if [[ -n "$AWS_STUB_FAIL" ]]; then
  echo "An error occurred (AccessDeniedException) when calling the GetSecretValue operation" >&2
  exit 255
fi

secret_id=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --secret-id) secret_id="$2"; shift 2 ;;
    *) shift ;;
  esac
done

key="secret_$(printf '%s' "$secret_id" | sed -e 's|[^A-Za-z0-9]|_|g')"

if [[ ! -f "$BB_FIXTURES/${key}.body" ]]; then
  echo "aws: no fixture for secret '$secret_id'" >&2
  exit 255
fi

cat "$BB_FIXTURES/${key}.body"
