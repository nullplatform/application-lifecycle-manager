#!/bin/bash
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export NRN="organization=1:account=2:namespace=3:application=42"
export ECR_REGION="us-east-1" ASSET_REPOSITORY='{}'
np_iam_provider '[{"selector":"OTHER_PROVIDER","arn":"arn:aws:iam::123456789012:role/other"}]'

run_script_step asset-repo/ecr/build_context
assert_status 0 || exit 1
assert_contains "using the agent's AWS credentials" || exit 1

if grep -q $'^aws\tsts' "$BB_CALLS"; then
  echo "  FAIL: assumed a role nobody configured:"
  sed 's/^/    /' "$BB_CALLS"
  exit 1
fi

credentials=$(ecr_build_context_credentials)
[[ -z "${credentials//$'\n'/}" ]] || { echo "  FAIL: exported credentials without a role: $credentials"; exit 1; }
