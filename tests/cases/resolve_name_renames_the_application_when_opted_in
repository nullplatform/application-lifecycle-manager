#!/bin/bash
# With APPLICATION_NAME_FROM_REPOSITORY=true the derived repository name becomes
# the application's name, handed over in the callback body the way the
# repository_url already is.
#
# The slug is left alone, in the callback and in this run. The platform answers
# 204 to a callback body carrying one and then ignores it -- measured against a
# real hook -- so switching APPLICATION_SLUG here would name the asset
# repository and the CI api key after a slug the application never gets.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export ALM_CALLBACK_BODY_FILE="$TEST_TMP/callback_body.json"
export CODE_REPOSITORY_STRATEGY="create"
export APPLICATION_NAME_FROM_REPOSITORY="true"
export APPLICATION_SLUG="whatever-was-typed"

REPOSITORY_NAME_RULE=$(wizard_rule)
export REPOSITORY_NAME_RULE

APPLICATION=$(wizard_metadata architecture=.NET dotnet_type=APP domain=fire subdomain=issuance \
  | jq -c '.name = "Whatever Was Typed" | .slug = "whatever-was-typed"')
export APPLICATION

slug=$(capture_code_repo_export resolve_repository_name APPLICATION_SLUG)

if [[ "$slug" != "whatever-was-typed" ]]; then
  echo "  FAIL: expected APPLICATION_SLUG to keep the slug the application was created with, got '$slug'"
  exit 1
fi

got=$(jq -r '.name // empty' "$ALM_CALLBACK_BODY_FILE" 2>/dev/null)
if [[ "$got" != "net-app-fire-issuance" ]]; then
  echo "  FAIL: expected name = the repository name in the callback body, got '$got'"
  echo "  callback body: $(cat "$ALM_CALLBACK_BODY_FILE" 2>/dev/null)"
  exit 1
fi

if jq -e 'has("slug")' "$ALM_CALLBACK_BODY_FILE" >/dev/null 2>&1; then
  echo "  FAIL: expected no slug in the callback body, got: $(cat "$ALM_CALLBACK_BODY_FILE")"
  exit 1
fi

run_code_repo_step resolve_repository_name
assert_contains "Whatever Was Typed" || exit 1
