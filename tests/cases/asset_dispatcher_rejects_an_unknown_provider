#!/bin/bash
# A provider with no directory here fails before the workflow runs, naming it.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export NRN="organization=1:account=2:namespace=3:application=4"
export ASSET_REPOSITORY_PROVIDER="harbor" CREATE_ASSET_REPOSITORY="true"

run_script_step asset-repo/create_asset_repository
assert_status 1 || exit 1
assert_contains "asset repository provider 'harbor' is not implemented" || exit 1
grep -q "service workflow exec" "$BB_CALLS" && { echo "  FAIL: the workflow still ran"; exit 1; }
exit 0
