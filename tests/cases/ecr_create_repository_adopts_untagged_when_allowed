#!/bin/bash
# ECR_ADOPT_UNTAGGED=true lets an installation take over repositories that existed
# before the provider, with a warning.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export ECR_REGION="us-east-1" ECR_REPOSITORY_NAME="a-b-c"
ecr_fixture create-repository 254 '' 'An error occurred (RepositoryAlreadyExistsException) when calling the CreateRepository operation'
ecr_fixture describe-repositories 0 '{"repositories":[{"repositoryUri":"123.dkr.ecr.us-east-1.amazonaws.com/a-b-c","repositoryArn":"arn:aws:ecr:us-east-1:123:repository/a-b-c"}]}'
np_patch_responses '0:{}'
ecr_fixture list-tags-for-resource 0 '{"tags":[]}'
export ECR_ADOPT_UNTAGGED=true

run_script_step asset-repo/ecr/create_repository
assert_status 0 || exit 1
assert_contains "WARNING: ECR repository a-b-c already exists without a nullplatform:application_id tag" || exit 1
[[ "$(patch_body | jq -r .settings.asset.ecr.uri)" == "123.dkr.ecr.us-east-1.amazonaws.com/a-b-c" ]] || { echo "  FAIL: adopted uri not patched: $(patch_body)"; exit 1; }
