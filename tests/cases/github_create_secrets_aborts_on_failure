#!/bin/bash
# The opposite call to add_collaborators, and deliberately so: the CI API key is
# what lets the pipeline talk to nullplatform at all. A repository whose secret
# silently failed to publish builds and then cannot push anything, which is worse
# than not creating it.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export GITHUB_ACCOUNT="acme"
export REPOSITORY_NAME="my-service"
export CODE_REPOSITORY_SECRETS='{"NULLPLATFORM_API_KEY":"the-key"}'

fixture PUT "/secrets/NULLPLATFORM_API_KEY" 500 ''

run_code_repo_step github/create_secrets

assert_status 1 || exit 1
assert_contains "ERROR: failed to create secret NULLPLATFORM_API_KEY" || exit 1
