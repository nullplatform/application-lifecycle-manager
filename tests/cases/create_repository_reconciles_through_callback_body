#!/bin/bash
# Inside a hook run the application is in pending_hook and refuses a PATCH
# (403 ENTITY_CREATION_HOOK_PENDING). The canonical URL must reach it through
# the hook's callback body, with no `np application patch` call.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export ALM_CALLBACK_BODY_FILE="$TEST_TMP/callback_body.json"
export CODE_REPOSITORY_STRATEGY="create"
export TEMPLATE_URL=""
export REPOSITORY_URL="https://github.com/acme/my-service"

fixture POST "/repositories/acme/my-service" 200 \
  '{"links":{"html":{"href":"https://bitbucket.org/acme/my-service"}}}'

run_step create_repository
assert_status 0 || exit 1

got=$(jq -r '.repository_url // empty' "$ALM_CALLBACK_BODY_FILE" 2>/dev/null)
if [[ "$got" != "https://bitbucket.org/acme/my-service" ]]; then
  echo "  FAIL: expected the canonical URL in the callback body, got '$got'"
  exit 1
fi

if grep -q 'application patch' "$BB_CALLS"; then
  echo "  FAIL: expected no PATCH while the hook holds the application. Calls:"
  sed 's/^/    /' "$BB_CALLS"
  exit 1
fi
