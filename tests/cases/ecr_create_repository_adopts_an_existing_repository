#!/bin/bash
# A rerun finds the repository already there: it is described, adopted with a
# warning, and its own URI is the one stored.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export ECR_REGION="us-east-1" ECR_REPOSITORY_NAME="payments-api"
ecr_fixture create-repository 254 '' 'An error occurred (RepositoryAlreadyExistsException) when calling the CreateRepository operation'
ecr_fixture describe-repositories 0 '{"repositories":[{"repositoryUri":"123.dkr.ecr.us-east-1.amazonaws.com/existing","repositoryArn":"arn:aws:ecr:us-east-1:123:repository/existing"}]}'
np_patch_responses '0:{}'

run_script_step asset-repo/ecr/create_repository
assert_status 0 || exit 1
assert_contains "WARNING: ECR repository payments-api already exists" || exit 1
[[ "$(patch_body | jq -r .settings.asset.ecr.uri)" == "123.dkr.ecr.us-east-1.amazonaws.com/existing" ]] || { echo "  FAIL: described uri not patched: $(patch_body)"; exit 1; }
