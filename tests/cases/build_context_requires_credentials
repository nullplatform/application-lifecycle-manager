#!/bin/bash
# App passwords are gone and OAuth/workspace tokens cannot enable Pipelines, so
# the bot user's API token is the one credential. If it is not configured, fail
# loudly and name it rather than proceeding to a confusing 401 later.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT
clear_context

export REPOSITORY_NAME="my-service"
export CODE_REPOSITORY='{"attributes":{"setup":{
  "workspace":"acme",
  "projectKey":"APP",
  "email":"bot@nullplatform.com"
}}}'

run_step build_context

assert_status 1 || exit 1
assert_contains "BITBUCKET_API_TOKEN is not set" || exit 1
assert_contains "apiToken" || exit 1
