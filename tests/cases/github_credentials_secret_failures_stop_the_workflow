#!/bin/bash
# A secret that cannot be read is a configuration problem -- missing, no IAM
# permission, wrong region -- and carrying on would fail later signing the JWT,
# which reads like a broken private key instead.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

unset GITHUB_APP_ID GITHUB_PRIVATE_KEY GITHUB_INSTALLATION_ID

export GITHUB_ACCOUNT="acme"
export GITHUB_APP_SECRET_ID="gh/acme"

failed=0

# Unreadable: the store's own message has to reach the log, it is the only thing
# that says whether this is permissions or a typo.
export AWS_STUB_FAIL=1
run_code_repo_step github/resolve_app_credentials
if [[ "$STEP_STATUS" != 1 ]]; then
  echo "  FAIL: an unreadable secret should exit 1, got $STEP_STATUS"
  failed=1
elif [[ "$STEP_OUTPUT" != *"AccessDenied"* ]]; then
  echo "  FAIL: the store's error was swallowed:"
  printf '%s\n' "$STEP_OUTPUT" | sed 's/^/        /'
  failed=1
fi
unset AWS_STUB_FAIL

# Readable but not a JSON object.
secret_fixture "gh/acme" 'ghp_a_plain_token_not_an_object'
run_code_repo_step github/resolve_app_credentials
if [[ "$STEP_STATUS" != 1 ]]; then
  echo "  FAIL: a non-object secret should exit 1, got $STEP_STATUS"
  failed=1
elif [[ "$STEP_OUTPUT" != *"does not hold a JSON object"* ]]; then
  echo "  FAIL: the shape problem was not explained:"
  printf '%s\n' "$STEP_OUTPUT" | sed 's/^/        /'
  failed=1
fi

# And the secret's own contents must never be echoed while explaining it.
if [[ "$STEP_OUTPUT" == *"ghp_a_plain_token"* ]]; then
  echo "  FAIL: the secret's contents leaked into the output"
  failed=1
fi

# An unknown store is rejected rather than silently ignored.
secret_fixture "gh/acme" '{"app_id":"1"}'
export GITHUB_APP_SECRET_STORE="vault"
run_code_repo_step github/resolve_app_credentials
if [[ "$STEP_STATUS" != 1 ]]; then
  echo "  FAIL: an unsupported store should exit 1, got $STEP_STATUS"
  failed=1
fi

exit "$failed"
