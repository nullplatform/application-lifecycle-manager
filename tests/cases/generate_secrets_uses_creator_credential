#!/bin/bash
# The agent's own key cannot create api keys, so NP_API_KEY_CREATOR overrides
# the credential for that one call. NP_TOKEN wins over NULLPLATFORM_API_KEY in
# the CLI, so it must be unset while the override is active and restored after.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export NAMESPACE_SLUG="ns"
export NAMESPACE_ID="1"
export APPLICATION_SLUG="app"
export APPLICATION_ID="2"
export NRN="organization=1:account=2"

export NP_TOKEN="agent-token"
export NP_API_KEY_CREATOR="creator-key"

# The stub records which credential was visible when api-key create ran.
cat > "$TEST_TMP/np" <<'STUB'
#!/bin/bash
if [[ "$1" == "api-key" ]]; then
  printf 'token=%s key=%s\n' "${NP_TOKEN:-unset}" "${NULLPLATFORM_API_KEY:-unset}" >> "$BB_CALLS"
  echo '{"id": 99, "api_key": "np-secret-value"}'
else
  echo '{}'
fi
STUB
chmod +x "$TEST_TMP/np"
export PATH="$TEST_TMP:$PATH"

(
  cd "$REPO_ROOT" || exit 1
  source scripts/code-repo/generate_secrets >/dev/null 2>&1
  # NP_TOKEN must be back to the agent's after the override.
  [[ "$NP_TOKEN" == "agent-token" ]] || { echo "NP_TOKEN not restored: $NP_TOKEN"; exit 1; }
  [[ -z "${NULLPLATFORM_API_KEY:-}" ]] || { echo "NULLPLATFORM_API_KEY leaked: $NULLPLATFORM_API_KEY"; exit 1; }
) || exit 1

grep -q 'token=unset key=creator-key' "$BB_CALLS" \
  || { echo "api-key create did not run under the creator credential:"; cat "$BB_CALLS"; exit 1; }
