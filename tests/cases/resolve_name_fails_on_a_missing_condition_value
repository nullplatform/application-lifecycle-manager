#!/bin/bash
# The value every condition in the rule is keyed on is missing, so no branch
# matches and the walk lands on the catch-all -- whose pattern asks for that same
# value. The step has to blame it by name.
#
# Worth pinning because the catch-all is the branch most likely to be written as
# a loose fallback: if it named only fields the wizard always fills in, a missing
# selector would quietly produce a plausible name instead of stopping.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

unset REPOSITORY_NAME

# The dispatcher settles the strategy before calling this step; these cases
# exercise the step on its own, so they set it themselves.
export CODE_REPOSITORY_STRATEGY="create"

REPOSITORY_NAME_RULE=$(wizard_rule)
APPLICATION=$(wizard_metadata domain=fire subdomain=issuance)
export REPOSITORY_NAME_RULE APPLICATION

run_code_repo_step resolve_repository_name

assert_status 1 || exit 1
assert_contains "architecture" || exit 1
