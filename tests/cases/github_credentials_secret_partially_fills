#!/bin/bash
# The secret fills only what the environment left empty. That is what lets a
# deployment keep the private key in the store while the installation id keeps
# coming from the nullplatform provider -- the common shape, since the id is not
# secret and already lives on the platform.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

unset GITHUB_APP_ID GITHUB_PRIVATE_KEY

export GITHUB_ACCOUNT="acme"
export GITHUB_INSTALLATION_ID="from-the-platform"
export GITHUB_APP_SECRET_ID="gh/acme"

secret_fixture "gh/acme" '{"app_id":"999","installation_id":"from-the-secret","private_key":"pem"}'

inst=$(capture_code_repo_export github/resolve_app_credentials GITHUB_INSTALLATION_ID)
if [[ "$inst" != "from-the-platform" ]]; then
  echo "  FAIL: the secret overwrote a value the environment already had: '$inst'"
  exit 1
fi

app=$(capture_code_repo_export github/resolve_app_credentials GITHUB_APP_ID)
if [[ "$app" != "999" ]]; then
  echo "  FAIL: the empty value was not filled from the secret: '$app'"
  exit 1
fi
