#!/bin/bash
# argv is world-readable through `ps auxww` and /proc/<pid>/cmdline for as long as
# the process runs, and monitoring agents routinely log full command lines. So
# neither the API token nor a secret request body may be passed as an argument.
# bb_scrub does not help here: it redacts captured OUTPUT, not the process's own
# argv.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

# An argv-recording curl. Unlike the fixture stub, it logs the whole argument
# list, and it still behaves enough like curl for bb_api (writes the -o file,
# echoes a status code).
cat > "$TEST_TMP/curl" <<'EOF'
#!/bin/bash
printf 'argv\t%s\n' "$*" >> "$BB_ARGV"

prev=""
for arg in "$@"; do
  [[ "$prev" == "-o" ]] && printf '' > "$arg"
  prev="$arg"
done

printf '200'
EOF
chmod +x "$TEST_TMP/curl"

export BB_ARGV="$TEST_TMP/argv.log"
: > "$BB_ARGV"
export PATH="$TEST_TMP:$PATH"
export BITBUCKET_API_TOKEN="super-secret-token"

(
  cd "$REPO_ROOT" || exit 1
  # shellcheck disable=SC1090
  source scripts/code-repo/bitbucket/_api
  bb_api POST "/repositories/acme/my-service" '{"value":"np-secret-value"}'
) >/dev/null 2>&1

if grep -q "super-secret-token" "$BB_ARGV"; then
  echo "  FAIL: the API token appeared in curl's argv:"
  sed 's/^/    /' "$BB_ARGV"
  exit 1
fi

if grep -q "np-secret-value" "$BB_ARGV"; then
  echo "  FAIL: a secret request body appeared in curl's argv:"
  sed 's/^/    /' "$BB_ARGV"
  exit 1
fi
