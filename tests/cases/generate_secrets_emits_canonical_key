#!/bin/bash
# The templates are SHARED by both provisioning paths, so both must inject the
# CI credential under the same canonical name: NULLPLATFORM_API_KEY (the old
# NP_API_KEY name was renamed away, see CHANGELOG.md "Changed").
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export NAMESPACE_SLUG="ns"
export NAMESPACE_ID="1"
export APPLICATION_SLUG="app"
export APPLICATION_ID="2"
export NRN="organization=1:account=2"

# The np stub returns '{}', so give api-key create a real answer.
cat > "$TEST_TMP/np" <<'EOF'
#!/bin/bash
printf 'np\t%s\n' "$*" >> "$BB_CALLS"
if [[ "$1" == "api-key" ]]; then
  echo '{"id": 99, "api_key": "np-secret-value"}'
else
  echo '{}'
fi
EOF
chmod +x "$TEST_TMP/np"
export PATH="$TEST_TMP:$PATH"

secrets=$(
  cd "$REPO_ROOT" || exit 1
  source scripts/code-repo/generate_secrets >/dev/null 2>&1
  printf '%s' "$CODE_REPOSITORY_SECRETS"
)

value=$(echo "$secrets" | jq -r '.NULLPLATFORM_API_KEY // empty')

if [[ "$value" != "np-secret-value" ]]; then
  echo "  FAIL: expected NULLPLATFORM_API_KEY to carry the CI api key, got '$value' from: $secrets"
  exit 1
fi
