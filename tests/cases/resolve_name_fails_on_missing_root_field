#!/bin/bash
# When the root field itself is missing the step must blame the root field. It
# used to fall through to the default branch and blame whatever that branch
# asked for first, sending whoever reads the hook messages after the wrong field.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

unset REPOSITORY_NAME

# The dispatcher settles the strategy before calling this step; these cases
# exercise the step on its own, so they set it themselves.
export CODE_REPOSITORY_STRATEGY="create"

REPOSITORY_NAME_RULE=$(wizard_rule)
APPLICATION=$(wizard_metadata domain=fire subdomain=issuance)
export REPOSITORY_NAME_RULE APPLICATION

run_code_repo_step resolve_repository_name

assert_status 1 || exit 1
assert_contains "architecture" || exit 1
