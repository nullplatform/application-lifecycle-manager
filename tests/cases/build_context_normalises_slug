#!/bin/bash
# REPOSITORY_NAME comes from `basename "$REPOSITORY_URL"` and is neither
# lower-cased nor .git-stripped. Bitbucket slugifies, so an un-normalised name
# would create the repo at a path we did not ask for -- and links.html.href
# would then disagree with the application's repository_url (Contract A).
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT
clear_context

export REPOSITORY_NAME="My-Service.git"
export CODE_REPOSITORY='{"attributes":{"setup":{
  "auth_method":"workspace_access_token",
  "workspace":"acme",
  "project_key":"APP",
  "access_token":"wat-token"
}}}'

slug=$(capture_export build_context REPOSITORY_SLUG)

if [[ "$slug" != "my-service" ]]; then
  echo "  FAIL: expected slug 'my-service', got '$slug'"
  exit 1
fi
