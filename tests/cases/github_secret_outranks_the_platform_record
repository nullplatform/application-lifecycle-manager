#!/bin/bash
# Three places can supply the installation id, and the order between them is the
# whole point: the agent's environment is the operator's deliberate choice, the
# secret is deliberate too and per organization, and the provider record on the
# platform is a shared default that is often stale.
#
#   environment  >  secret  >  provider record
#
# Getting this wrong is not loud. A stale provider record holds a VALID id -- it
# just belongs to a different App -- so the JWT signs fine and GitHub answers 404
# on the installation, which reads like the App was never installed.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

TOKEN_FROM_SECRET="https://api.github.com/app/installations/from-secret/access_tokens"
TOKEN_FROM_ENV="https://api.github.com/app/installations/from-env/access_tokens"

export GITHUB_ACCOUNT="acme"
export GITHUB_APP_SECRET_ID="gh/acme"

# The provider record carries a stale id, the way a terraform-managed one does.
export CODE_REPOSITORY='{"attributes":{"setup":{"installation_id":"from-the-stale-provider","organization":"acme"}}}'

secret_fixture "gh/acme" '{"app_id":"123","installation_id":"from-secret","private_key":"pem"}'

fixture POST "$TOKEN_FROM_SECRET" 201 '{"token":"ghs_via_secret"}'
fixture POST "$TOKEN_FROM_ENV"    201 '{"token":"ghs_via_env"}'

failed=0

# The secret must beat the provider record.
unset GITHUB_INSTALLATION_ID GITHUB_APP_ID GITHUB_PRIVATE_KEY
got=$(capture_code_repo_export github/build_context GH_TOKEN)
if [[ "$got" != "ghs_via_secret" ]]; then
  echo "  FAIL: the stale provider record beat the secret. Got token '$got'"
  failed=1
fi

# And the environment must still beat the secret.
unset GITHUB_APP_ID GITHUB_PRIVATE_KEY
export GITHUB_INSTALLATION_ID="from-env"
got=$(capture_code_repo_export github/build_context GH_TOKEN)
if [[ "$got" != "ghs_via_env" ]]; then
  echo "  FAIL: the secret beat an explicit environment value. Got token '$got'"
  failed=1
fi

exit "$failed"
