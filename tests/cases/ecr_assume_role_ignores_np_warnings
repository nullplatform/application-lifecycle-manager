#!/bin/bash
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export NRN="organization=1:account=2:namespace=3:application=42"
export ECR_REGION="us-east-1" ASSET_REPOSITORY='{}'
np_iam_provider '[{"selector":"ASSET_PROVIDER_ECR","arn":"arn:aws:iam::123456789012:role/ecr-writer"}]'

NP_STUB_IAM_STDERR="Warning: a newer np version is available" run_script_step asset-repo/ecr/build_context
assert_status 0 || exit 1
grep -qF -- "--role-arn=arn:aws:iam::123456789012:role/ecr-writer " "$BB_CALLS" \
  || { echo "  FAIL: a warning on stderr hid the provider role:"; sed 's/^/    /' "$BB_CALLS"; exit 1; }
