#!/bin/bash
# Bitbucket answers the repository-create call before the new repository is usable
# over git, so the first push can come back unauthenticated. git then asks for a
# username, which GIT_TERMINAL_PROMPT=0 turns into "could not read Username" --
# observed intermittently against a real workspace on 2026-08-03, with a token that
# had worked minutes earlier. It clears on its own, so the push is retried.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export CODE_REPOSITORY_STRATEGY="create"
export REPOSITORY_URL="https://bitbucket.org/acme/my-service"
export TEMPLATE_URL="https://github.com/nullplatform/technology-templates-nodejs"
export BB_PUSH_RETRY_DELAY=0

# A git that fails the FIRST push the way a not-yet-ready repository does, and
# succeeds afterwards.
cat > "$TEST_TMP/git" <<'EOF'
#!/bin/bash
printf 'git\t%s\n' "$*" >> "$BB_CALLS"

if [[ "$1" == "clone" ]]; then
  for arg in "$@"; do target="$arg"; done
  mkdir -p "$target/.git"
  echo "template" > "$target/README.md"
  exit 0
fi

if [[ "$*" == *push* ]]; then
  count=0
  [[ -f "$TEST_TMP/push_count" ]] && count=$(cat "$TEST_TMP/push_count")
  count=$((count + 1))
  printf '%s' "$count" > "$TEST_TMP/push_count"

  if [[ "$count" -eq 1 ]]; then
    echo "fatal: could not read Username for 'https://bitbucket.org': terminal prompts disabled" >&2
    exit 128
  fi
fi

exit 0
EOF
chmod +x "$TEST_TMP/git"
export TEST_TMP
export PATH="$TEST_TMP:$PATH"

fixture POST "/repositories/acme/my-service" 200 \
  '{"links":{"html":{"href":"https://bitbucket.org/acme/my-service"}}}'

run_step create_repository

assert_status 0 || exit 1
assert_contains "retrying" || exit 1
assert_contains "Template pushed to" || exit 1

pushes=$(cat "$TEST_TMP/push_count" 2>/dev/null)

if [[ "$pushes" != "2" ]]; then
  echo "  FAIL: expected the push to be retried once (2 attempts), saw '$pushes'"
  exit 1
fi
