#!/bin/bash
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export NRN="organization=1:account=2:namespace=3:application=42"
export ECR_REGION="us-east-1" ASSET_REPOSITORY='{}'
export ECR_ASSUME_ROLE_ARN_DEFAULT="arn:aws:iam::123456789012:role/default"
np_iam_provider '[]'

NP_STUB_IAM_FAIL=1 run_script_step asset-repo/ecr/build_context
assert_status 1 || exit 1
assert_contains "ERROR: could not read the identity-access-control provider" || exit 1
assert_contains "503 Service Unavailable" || exit 1

NP_STUB_IAM_BODY='<html>gateway timeout</html>' run_script_step asset-repo/ecr/build_context
assert_status 1 || exit 1
assert_contains "did not return JSON" || exit 1

if grep -q $'^aws\tsts' "$BB_CALLS"; then
  echo "  FAIL: fell back to a role after a broken lookup:"
  sed 's/^/    /' "$BB_CALLS"
  exit 1
fi
