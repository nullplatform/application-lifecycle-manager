#!/bin/bash
# On import, a pipeline may already be running on the branch. Stop it before
# triggering ours, the way the GitHub step cancels in-progress runs -- otherwise
# two builds race for the same branch. A freshly created repository cannot have
# pipelines yet (Pipelines is enabled after the seed push), so this is scoped to
# the import strategy.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export CODE_REPOSITORY_STRATEGY="import"
export BITBUCKET_MAIN_BRANCH="main"

PIPELINES="/repositories/acme/my-service/pipelines/"

fixture GET "/repositories/acme/my-service/pipelines_config" 200 '{"enabled":true}'
fixture GET "${PIPELINES}?sort=-created_on&pagelen=20" 200 \
  '{"values":[
     {"uuid":"{p1}","state":{"name":"IN_PROGRESS"},"target":{"ref_name":"main"}},
     {"uuid":"{p2}","state":{"name":"COMPLETED"},"target":{"ref_name":"main"}},
     {"uuid":"{p3}","state":{"name":"IN_PROGRESS"},"target":{"ref_name":"other"}}
   ]}'
fixture POST "${PIPELINES}%7Bp1%7D/stopPipeline" 204 ''
fixture POST "$PIPELINES" 201 '{"build_number":7}'

run_step run_first_build

assert_status 0 || exit 1
assert_called POST "${PIPELINES}%7Bp1%7D/stopPipeline" || exit 1
assert_called POST "$PIPELINES" || exit 1

# A finished pipeline, and one on another branch, must be left alone.
for uuid in p2 p3; do
  if grep -q "%7B${uuid}%7D/stopPipeline" "$BB_CALLS"; then
    echo "  FAIL: stopped pipeline $uuid, which was not in flight on 'main'. Calls:"
    sed 's/^/    /' "$BB_CALLS"
    exit 1
  fi
done
