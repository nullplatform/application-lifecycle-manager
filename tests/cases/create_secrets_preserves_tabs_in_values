#!/bin/bash
# The loop used to feed itself `jq -r ... | @tsv` and split on IFS=$'\t'. @tsv
# ESCAPES a tab, so a secret value containing one arrived as the two characters
# backslash-t and was stored that way: a corrupted credential that looks stored
# fine and fails at CI time with no clue why.
#
# (generate_secrets builds CODE_REPOSITORY_SECRETS with `jq --arg`, so the tab is
# \t-escaped in the JSON, as below, and is a real tab once decoded.)
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

VARS="/repositories/acme/my-service/pipelines_config/variables"

export CODE_REPOSITORY_SECRETS='{"NULLPLATFORM_API_KEY":"before\tafter"}'

fixture GET "${VARS}?pagelen=100" 200 '{"values":[]}'
fixture POST "$VARS" 201 '{"key":"NULLPLATFORM_API_KEY"}'

run_step create_secrets

assert_status 0 || exit 1
assert_called POST "$VARS" || exit 1

sent=$(request_body POST "$VARS")
value=$(echo "$sent" | jq -r '.value')

if [[ "$value" != $'before\tafter' ]]; then
  echo "  FAIL: the tab in the secret value did not survive. Sent: $sent"
  exit 1
fi

if [[ "$(echo "$sent" | jq -r '.secured')" != "true" ]]; then
  echo "  FAIL: the secret was not stored secured. Sent: $sent"
  exit 1
fi
