#!/bin/bash
# Pipeline variables have no upsert, so an existing key has to be found even when
# it lives past the first page. The 409 recovery used to re-read page 1 only, so
# the case its own comment claimed to handle could never actually work.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

VARS="/repositories/acme/my-service/pipelines_config/variables"

export CODE_REPOSITORY_SECRETS='{"NULLPLATFORM_API_KEY":"np-secret-value"}'

fixture GET "${VARS}?pagelen=100" 200 \
  "{\"values\":[{\"key\":\"OTHER\",\"uuid\":\"{aaa}\"}],\"next\":\"https://api.bitbucket.org/2.0${VARS}?pagelen=100&page=2\"}"
fixture GET "${VARS}?pagelen=100&page=2" 200 \
  '{"values":[{"key":"NULLPLATFORM_API_KEY","uuid":"{bbb}"}]}'
fixture PUT "${VARS}/%7Bbbb%7D" 200 '{"key":"NULLPLATFORM_API_KEY"}'

run_step create_secrets

assert_status 0 || exit 1
assert_called PUT "${VARS}/%7Bbbb%7D" || exit 1

if grep -q "^POST	${VARS}	" "$BB_CALLS"; then
  echo "  FAIL: POSTed a key that already existed on page 2. Calls:"
  sed 's/^/    /' "$BB_CALLS"
  exit 1
fi
