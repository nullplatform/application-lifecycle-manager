#!/bin/bash
# The aws variants of the agent image ship python3 with cryptography. Reaching for
# mise there anyway would download ~110MB of python on every new pod for nothing.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

mise_python_stub

run_resolve_python
assert_status 0 || exit 1

if [[ "$RESOLVED_PYTHON" != "python3" ]]; then
  echo "  FAIL: expected the system python3, got '$RESOLVED_PYTHON'"
  exit 1
fi

if grep -q "^mise" "$BB_CALLS"; then
  echo "  FAIL: it called mise even though python3 could sign. Calls:"
  sed 's/^/    /' "$BB_CALLS"
  exit 1
fi
