#!/bin/bash
# The asset location is a nested object, and it reaches the hook close as one.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

CALLBACK_URL="https://api.nullplatform.com/entity_hook/abc123"

export NP_API_KEY="test-key"
export NP_ACTION_CONTEXT="{\"notification\":{\"callback_url\":\"$CALLBACK_URL\",\"nrn\":\"organization=1:account=2:namespace=3:application=4\"}}"

export ALM_CALLBACK_BODY_FILE="$TEST_TMP/callback_body.json"
echo '{"settings":{"asset":{"ecr":{"uri":"123.dkr.ecr.us-east-1.amazonaws.com/payments-api","arn":"arn:aws:ecr:us-east-1:123:repository/payments-api"}}}}' > "$ALM_CALLBACK_BODY_FILE"

fixture PATCH "$CALLBACK_URL" 200 ""

(cd "$REPO_ROOT" && bash entrypoint) >/dev/null 2>&1

body=$(request_body PATCH "$CALLBACK_URL")
got=$(printf '%b' "$body" | jq -r '.callback_body.settings.asset.ecr.uri // empty' 2>/dev/null)

if [[ "$got" != "123.dkr.ecr.us-east-1.amazonaws.com/payments-api" ]]; then
  echo "  FAIL: expected settings.asset.ecr.uri in callback_body, got '$got'"
  printf '%b\n' "$body" | sed 's/^/    /'
  exit 1
fi
