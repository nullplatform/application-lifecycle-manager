#!/bin/bash
# The retry exists for the slug and nothing else. A close refused for any other
# reason is reported as it always was, and not sent a second time: there is no
# field to drop that would make the platform accept it.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

CALLBACK_URL="https://api.nullplatform.com/entity_hook/abc123"

export NP_API_KEY="test-key"
export NP_ACTION_CONTEXT="{\"notification\":{\"callback_url\":\"$CALLBACK_URL\",\"nrn\":\"organization=1:account=2:namespace=3:application=4\"}}"

export ALM_CALLBACK_BODY_FILE="$TEST_TMP/callback_body.json"
echo '{"repository_url":"https://github.com/acme/net-app-fire-issuance"}' > "$ALM_CALLBACK_BODY_FILE"

fixture PATCH "$CALLBACK_URL" 400 '{"message":"nope"}'

(cd "$REPO_ROOT" && bash entrypoint) >/dev/null 2>&1

calls=$(grep -cF "$(printf 'PATCH\t%s\t' "$CALLBACK_URL")" "$BB_CALLS")
if [[ "$calls" -ne 1 ]]; then
  echo "  FAIL: expected a single close attempt without a slug in the body, got $calls"
  exit 1
fi
