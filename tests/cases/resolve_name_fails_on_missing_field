#!/bin/bash
# A placeholder the wizard did not fill in, and that the pattern does not mark
# optional, must stop the workflow naming that path. Silently leaving the segment
# out would produce 'net-app-issuance' -- one short, and indistinguishable from
# a name that was meant to look like that. Because this runs inside a
# before-create hook the application would be created pointing at a repository
# nobody can find.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

unset REPOSITORY_NAME

# The dispatcher settles the strategy before calling this step; these cases
# exercise the step on its own, so they set it themselves.
export CODE_REPOSITORY_STRATEGY="create"

REPOSITORY_NAME_RULE=$(wizard_rule)
APPLICATION=$(wizard_metadata architecture=.NET dotnet_type=APP subdomain=issuance)
export REPOSITORY_NAME_RULE APPLICATION

run_code_repo_step resolve_repository_name

assert_status 1 || exit 1
assert_contains "domain" || exit 1
