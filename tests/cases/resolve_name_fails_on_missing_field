#!/bin/bash
# A branch field the wizard did not fill in must stop the workflow naming that
# field. Silently emitting an empty segment would produce 'net-app--issuance',
# and because this runs inside a before-create hook the application would be
# created pointing at a repository nobody can find.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

unset REPOSITORY_NAME

REPOSITORY_NAME_RULE=$(wizard_rule)
APPLICATION=$(wizard_metadata architecture=.NET dotnet_type=APP subdomain=issuance)
export REPOSITORY_NAME_RULE APPLICATION

run_code_repo_step resolve_repository_name

assert_status 1 || exit 1
assert_contains "domain" || exit 1
