#!/bin/bash
# The App credentials can only come from the agent's environment -- there is no
# platform fallback for them, by design. Missing either one has to fail here,
# naming the variable, rather than further down with a GitHub authentication
# error that says nothing about what to configure.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

failed=0

expect_missing() {
  local var="$1"

  : > "$BB_CALLS"

  export GITHUB_APP_ID="123" GITHUB_PRIVATE_KEY="pem"
  unset "$var"

  run_code_repo_step github/build_context

  if [[ "$STEP_STATUS" != 1 ]]; then
    echo "  FAIL: missing $var should exit 1, got $STEP_STATUS"
    failed=1
    return
  fi

  if [[ "$STEP_OUTPUT" != *"ERROR: $var is required"* ]]; then
    echo "  FAIL: missing $var was not named in:"
    printf '%s\n' "$STEP_OUTPUT" | sed 's/^/        /'
    failed=1
  fi
}

expect_missing GITHUB_APP_ID
expect_missing GITHUB_PRIVATE_KEY

exit "$failed"
