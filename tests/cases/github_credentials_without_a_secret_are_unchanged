#!/bin/bash
# The regression guard for every deployment that keeps its credentials in the
# environment: without GITHUB_APP_SECRET_ID the step returns having touched
# nothing and having talked to no secrets store.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

unset GITHUB_APP_SECRET_ID

export GITHUB_APP_ID="from-env"
export GITHUB_PRIVATE_KEY="key-from-env"
export GITHUB_INSTALLATION_ID="inst-from-env"
export GITHUB_ACCOUNT="acme"

run_code_repo_step github/resolve_app_credentials
assert_status 0 || exit 1

if [[ -n "$STEP_OUTPUT" ]]; then
  echo "  FAIL: expected no output when there is nothing to do, got:"
  printf '%s\n' "$STEP_OUTPUT" | sed 's/^/    /'
  exit 1
fi

if grep -q "^aws" "$BB_CALLS"; then
  echo "  FAIL: it called aws with no secret configured. Calls:"
  sed 's/^/    /' "$BB_CALLS"
  exit 1
fi

got=$(capture_code_repo_export github/resolve_app_credentials GITHUB_APP_ID)
if [[ "$got" != "from-env" ]]; then
  echo "  FAIL: the environment value was not preserved, got '$got'"
  exit 1
fi
