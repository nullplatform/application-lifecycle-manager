#!/bin/bash
# The value travels on stdin, never on argv, so it stays out of the process list
# and out of any log that records the command line. This checks the secret really
# arrives -- publishing an empty one would leave CI failing to authenticate with a
# message that points nowhere near here.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export GITHUB_ACCOUNT="acme"
export REPOSITORY_NAME="my-service"
export CODE_REPOSITORY_SECRETS='{"NULLPLATFORM_API_KEY":"the-key"}'

fixture PUT "/secrets/NULLPLATFORM_API_KEY" 201 ''

run_code_repo_step github/create_secrets
assert_status 0 || exit 1

stored=$(grep '^gh-secret' "$BB_CALLS" | head -1 | cut -f3)

if [[ "$stored" != "the-key" ]]; then
  echo "  FAIL: expected the secret value 'the-key' to be published, got '$stored'"
  sed 's/^/    /' "$BB_CALLS"
  exit 1
fi

if grep -q "the-key" <(grep '^gh	' "$BB_CALLS"); then
  echo "  FAIL: the secret value appeared on the gh command line"
  exit 1
fi
