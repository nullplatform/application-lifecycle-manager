#!/bin/bash
# The App's private key is the one genuinely secret value of the three, and in
# the environment it ends up in the terraform state, in the Helm values and in
# any `kubectl describe`. GITHUB_APP_SECRET_ID moves it to a secrets store the
# agent reads at run time with its own IAM identity.
#
# The id is templated per organization, so one agent can serve several GitHub
# orgs without a redeploy -- adding one is a new secret, not a new deployment.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

unset GITHUB_APP_ID GITHUB_PRIVATE_KEY GITHUB_INSTALLATION_ID

export GITHUB_ACCOUNT="acme"

# Single quotes on purpose: the placeholder has to reach the step unexpanded --
# expanding it here would test nothing.
# shellcheck disable=SC2016
export GITHUB_APP_SECRET_ID='nullplatform/github-apps/${GITHUB_ACCOUNT}'

secret_fixture "nullplatform/github-apps/acme" '{
  "app_id": "4966079",
  "installation_id": "162217903",
  "private_key": "-----BEGIN RSA PRIVATE KEY-----\nSECRET\n-----END RSA PRIVATE KEY-----"
}'

failed=0

for var in GITHUB_APP_ID:4966079 GITHUB_INSTALLATION_ID:162217903; do
  got=$(capture_code_repo_export github/resolve_app_credentials "${var%%:*}")
  if [[ "$got" != "${var##*:}" ]]; then
    echo "  FAIL: expected ${var%%:*}='${var##*:}', got '$got'"
    failed=1
  fi
done

key=$(capture_code_repo_export github/resolve_app_credentials GITHUB_PRIVATE_KEY)
if [[ "$key" != *"BEGIN RSA PRIVATE KEY"* ]]; then
  echo "  FAIL: the private key did not come through: '$key'"
  failed=1
fi

# The templated id has to be resolved against the account, not passed literally.
run_code_repo_step github/resolve_app_credentials
if ! grep -qF -- "--secret-id nullplatform/github-apps/acme" "$BB_CALLS"; then
  echo "  FAIL: the secret id was not expanded. Calls:"
  sed 's/^/    /' "$BB_CALLS"
  failed=1
fi

# The key must never reach the log: hook messages are shown in the console.
if [[ "$STEP_OUTPUT" == *"SECRET"* || "$STEP_OUTPUT" == *"BEGIN RSA"* ]]; then
  echo "  FAIL: the private key leaked into the step output:"
  printf '%s\n' "$STEP_OUTPUT" | sed 's/^/    /'
  failed=1
fi

exit "$failed"
