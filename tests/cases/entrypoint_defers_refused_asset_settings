#!/bin/bash
# A refused close leaves the hook pending and blocks the namespace. If it is
# refused while carrying the asset location, entrypoint closes again without it
# -- keeping every other field -- and writes the location with a PATCH once the
# hook no longer holds the application.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

CALLBACK_URL="https://api.nullplatform.com/entity_hook/abc123"

export NP_API_KEY="test-key"
export NP_ACTION_CONTEXT="{\"notification\":{\"callback_url\":\"$CALLBACK_URL\",\"nrn\":\"organization=1:account=2:namespace=3:application=4\"}}"
export ASSET_PATCH_RETRY_DELAY=0

export ALM_CALLBACK_BODY_FILE="$TEST_TMP/callback_body.json"
echo '{"repository_url":"https://github.com/acme/payments-api","settings":{"asset":{"ecr":{"uri":"u","arn":"a"}}}}' > "$ALM_CALLBACK_BODY_FILE"

fixture_seq PATCH "$CALLBACK_URL" 1 400 '{"message":"invalid field settings"}'
fixture_seq PATCH "$CALLBACK_URL" 2 200 ""
np_patch_responses '0:{}'

output=$(cd "$REPO_ROOT" && bash entrypoint 2>&1)

calls=$(grep -cF "$(printf 'PATCH\t%s\t' "$CALLBACK_URL")" "$BB_CALLS")
[[ "$calls" -eq 2 ]] || { echo "  FAIL: expected two closes (refused, then without settings), got $calls"; exit 1; }

second=$(grep -F "$(printf 'PATCH\t%s\t' "$CALLBACK_URL")" "$BB_CALLS" | sed -n 2p | cut -f3)
if ! printf '%b' "$second" | jq -e '.callback_body | (has("settings") | not) and .repository_url == "https://github.com/acme/payments-api"' >/dev/null 2>&1; then
  echo "  FAIL: expected the retry to drop only settings, sent:"
  printf '%b\n' "$second" | sed 's/^/    /'
  exit 1
fi

grep -q $'^np\tapplication patch --id 4 ' "$BB_CALLS" || { echo "  FAIL: the location was not patched after the close"; cat "$BB_CALLS"; exit 1; }
[[ "$(patch_body | jq -r .settings.asset.ecr.uri)" == "u" ]] || { echo "  FAIL: wrong deferred patch body: $(patch_body)"; exit 1; }
[[ "$output" == *"WARNING"*"asset repository location"* ]] || { echo "  FAIL: expected a WARNING about the location, got:"; printf '%s\n' "$output" | sed 's/^/    /'; exit 1; }
