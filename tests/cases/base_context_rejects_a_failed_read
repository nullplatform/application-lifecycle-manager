#!/bin/bash
# base_context builds CONTEXT from three `np ... read` calls and used to check
# none of them. A transient API failure therefore left --argjson holding
# something that is not JSON, the whole jq failed, and CONTEXT came out empty --
# which every later step is entitled to assume is there.
#
# Downstream that surfaced as the wrong complaint: resolve_repository_name
# swallows jq's errors so a path leading nowhere reads as "absent", so an empty
# context made it blame the first field the naming pattern asked for -- a field
# the developer did fill in, in a message they cannot act on.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export NP_ACTION_CONTEXT='{"notification":{"nrn":"organization=1:account=2:namespace=3:application=4"}}'

failed=0

expect_rejected() {
  local label="$1" broken="$2"

  cat > "$TEST_TMP/np" <<STUB
#!/bin/bash
printf 'np\t%s\n' "\$*" >> "\$BB_CALLS"
if [[ "\$1" == "$broken" ]]; then
  # What the CLI does on a failed read: a message on stderr, nothing on stdout.
  echo "error: request failed" >&2
  exit 1
fi
echo '{"slug": "something"}'
STUB
  chmod +x "$TEST_TMP/np"
  export PATH="$TEST_TMP:$PATH"

  # shellcheck disable=SC1091
  output=$(cd "$REPO_ROOT" && source scripts/base_context 2>&1)
  status=$?

  if [[ "$status" -eq 0 ]]; then
    echo "  FAIL: a failed '$broken' read must stop the workflow, got 0"
    printf '%s\n' "$output" | sed 's/^/        /'
    failed=1
    return
  fi

  if [[ "$output" != *"$broken"* ]]; then
    echo "  FAIL: a failed '$broken' read did not name which document was missing:"
    printf '%s\n' "$output" | sed 's/^/        /'
    failed=1
  fi
}

expect_rejected "an account that does not resolve"     account
expect_rejected "a namespace that does not resolve"    namespace
expect_rejected "an application that does not resolve" application

exit "$failed"
