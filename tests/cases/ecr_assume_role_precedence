#!/bin/bash
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export NRN="organization=1:account=2:namespace=3:application=42"
export ECR_REGION="us-east-1" ASSET_REPOSITORY='{}'
np_iam_provider '[{"selector":"ASSET_PROVIDER_ECR","arn":"arn:aws:iam::123456789012:role/from-provider"}]'

ECR_ASSUME_ROLE_ARN="arn:aws:iam::123456789012:role/override" ECR_ASSUME_ROLE_ARN_DEFAULT="arn:aws:iam::123456789012:role/default" \
  run_script_step asset-repo/ecr/build_context
assert_status 0 || exit 1
grep -qF -- "--role-arn=arn:aws:iam::123456789012:role/override " "$BB_CALLS" \
  || { echo "  FAIL: ECR_ASSUME_ROLE_ARN did not win:"; sed 's/^/    /' "$BB_CALLS"; exit 1; }
if grep -q $'^np\tprovider list' "$BB_CALLS"; then
  echo "  FAIL: looked up the IAM provider despite the override"
  exit 1
fi

: > "$BB_CALLS"
ECR_ASSUME_ROLE_ARN_DEFAULT="arn:aws:iam::123456789012:role/default" run_script_step asset-repo/ecr/build_context
assert_status 0 || exit 1
grep -qF -- "--role-arn=arn:aws:iam::123456789012:role/from-provider " "$BB_CALLS" \
  || { echo "  FAIL: the IAM provider did not win over the default:"; sed 's/^/    /' "$BB_CALLS"; exit 1; }

: > "$BB_CALLS"
np_iam_provider '[]'
ECR_ASSUME_ROLE_ARN_DEFAULT="arn:aws:iam::123456789012:role/default" run_script_step asset-repo/ecr/build_context
assert_status 0 || exit 1
grep -qF -- "--role-arn=arn:aws:iam::123456789012:role/default " "$BB_CALLS" \
  || { echo "  FAIL: ECR_ASSUME_ROLE_ARN_DEFAULT not used as the fallback:"; sed 's/^/    /' "$BB_CALLS"; exit 1; }
