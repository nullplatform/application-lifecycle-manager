#!/bin/bash
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

unset REPOSITORY_NAME REPOSITORY_NAME_DERIVED

export ALM_CALLBACK_BODY_FILE="$TEST_TMP/callback_body.json"
export CODE_REPOSITORY_STRATEGY="import"
export APPLICATION_NAME_FROM_REPOSITORY="true"
export APPLICATION_SLUG="whatever-was-typed"

REPOSITORY_NAME_RULE=$(wizard_rule)
export REPOSITORY_NAME_RULE

APPLICATION=$(wizard_metadata architecture=.NET dotnet_type=APP domain=fire subdomain=issuance \
  | jq -c '.name = "Whatever Was Typed" | .slug = "whatever-was-typed"
    | .repository_url = "https://github.com/acme/legacy-service" | del(.template_id)')
export APPLICATION

slug=$(capture_code_repo_export resolve_repository_name APPLICATION_SLUG)

if [[ "$slug" != "net-app-fire-issuance" ]]; then
  echo "  FAIL: expected APPLICATION_SLUG to become the derived name on an import, got '$slug'"
  exit 1
fi

for key in name slug; do
  got=$(jq -r --arg k "$key" '.[$k] // empty' "$ALM_CALLBACK_BODY_FILE" 2>/dev/null)

  if [[ "$got" != "net-app-fire-issuance" ]]; then
    echo "  FAIL: expected '$key' = the derived name in the callback body, got '$got'"
    echo "  callback body: $(cat "$ALM_CALLBACK_BODY_FILE" 2>/dev/null)"
    exit 1
  fi
done

if [[ "$(jq -r '.repository_url // empty' "$ALM_CALLBACK_BODY_FILE")" != "" ]]; then
  echo "  FAIL: an import must not hand the application a new repository_url"
  exit 1
fi

name=$(capture_code_repo_export resolve_repository_name REPOSITORY_NAME)
derived=$(capture_code_repo_export resolve_repository_name REPOSITORY_NAME_DERIVED)

if [[ -n "$name" || -n "$derived" ]]; then
  echo "  FAIL: an import must keep its repository name; got REPOSITORY_NAME='$name' REPOSITORY_NAME_DERIVED='$derived'"
  exit 1
fi
