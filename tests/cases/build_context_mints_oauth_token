#!/bin/bash
# 2LO works on every Bitbucket plan, unlike a workspace access token (Premium
# only), so it must produce a BITBUCKET_TOKEN exactly like the WAT path does.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT
clear_context

export REPOSITORY_NAME="my-service"
export CODE_REPOSITORY='{"attributes":{"setup":{
  "auth_method":"oauth2",
  "workspace":"acme",
  "project_key":"APP",
  "oauth_key":"KEY123",
  "oauth_secret":"SECRET456"
}}}'

fixture POST "https://bitbucket.org/site/oauth2/access_token" 200 \
  '{"access_token":"minted-token","expires_in":7200,"token_type":"bearer"}'

token=$(capture_export build_context BITBUCKET_TOKEN)

if [[ "$token" != "minted-token" ]]; then
  echo "  FAIL: expected the minted OAuth token, got '$token'"
  exit 1
fi

run_step build_context
assert_status 0 || exit 1

# The secret must never reach the logs.
if [[ "$STEP_OUTPUT" == *"SECRET456"* || "$STEP_OUTPUT" == *"minted-token"* ]]; then
  echo "  FAIL: credentials leaked into the step output:"
  printf '%s\n' "$STEP_OUTPUT" | sed 's/^/    /'
  exit 1
fi
