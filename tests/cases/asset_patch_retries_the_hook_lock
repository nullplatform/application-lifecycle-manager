#!/bin/bash
# The creation hook answers ENTITY_CREATION_HOOK_PENDING for a few seconds; the
# same PATCH then applies, so that answer is waited out.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export DOCKER_SERVER_URI="registry.example.com/apps/payments-api" ASSET_PATCH_RETRY_DELAY=0
np_patch_responses '1:{"code":"ENTITY_HOOKS.ENTITY_CREATION_HOOK_PENDING"}' '1:{"code":"ENTITY_HOOKS.ENTITY_CREATION_HOOK_PENDING"}' '0:{}'

run_script_step asset-repo/docker-server/create_repository
assert_status 0 || exit 1
[[ "$(patch_count)" == 3 ]] || { echo "  FAIL: expected 3 attempts, got $(patch_count)"; exit 1; }
assert_contains "still held by its creation hook" || exit 1
