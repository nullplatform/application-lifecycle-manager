#!/bin/bash
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

export NRN="organization=1:account=2:namespace=3:application=42"
export ECR_REGION="us-east-1" ASSET_REPOSITORY='{}'
np_iam_provider '[{"selector":"asset_provider_ecr","arn":"arn:aws:iam::123456789012:role/ecr-writer"}]'

ECR_ASSUME_ROLE_ARN="--profile=admin" run_script_step asset-repo/ecr/build_context
assert_status 1 || exit 1
assert_contains "is not an IAM role ARN" || exit 1

: > "$BB_CALLS"
np_iam_provider '[]'
ECR_ASSUME_ROLE_ARN_DEFAULT="not-an-arn" run_script_step asset-repo/ecr/build_context
assert_status 1 || exit 1
assert_contains "is not an IAM role ARN" || exit 1

if grep -q $'^aws\tsts' "$BB_CALLS"; then
  echo "  FAIL: assumed a malformed ARN"
  exit 1
fi
