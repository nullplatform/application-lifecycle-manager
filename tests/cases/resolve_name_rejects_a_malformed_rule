#!/bin/bash
# The rule is written by whoever configures the agent, and the developer creating
# an application cannot see it. So a malformed one has to say the rule is wrong,
# not blame a metadata field the developer did fill in -- and it must never end
# with a name that looks derived.
source "$(dirname "$0")/../lib.sh"
setup
trap teardown EXIT

failed=0

expect_rejected() {
  local label="$1" rule="$2" needle="$3"

  unset REPOSITORY_NAME REPOSITORY_NAME_RULE_B64
  export CODE_REPOSITORY_STRATEGY="create"
  export REPOSITORY_NAME_RULE="$rule"
  APPLICATION=$(wizard_metadata architecture=.NET dotnet_type=APP domain=fire subdomain=issuance)
  export APPLICATION

  run_code_repo_step resolve_repository_name

  if [[ "$STEP_STATUS" != 1 ]]; then
    echo "  FAIL: $label should exit 1, got $STEP_STATUS"
    printf '%s\n' "$STEP_OUTPUT" | sed 's/^/        /'
    failed=1
    return
  fi
  if [[ "$STEP_OUTPUT" != *"$needle"* ]]; then
    echo "  FAIL: $label did not mention '$needle':"
    printf '%s\n' "$STEP_OUTPUT" | sed 's/^/        /'
    failed=1
  fi
}

md=".application.metadata.application"

# `jsonencode(file("rules.json"))` in terraform hands over the document as a JSON
# *string*, quotes and all, which `jq -e .` happily accepts -- so without this the
# mistake surfaced much later as a jq error about indexing a string.
expect_rejected "a rule that is a JSON string" \
  '"{\"branches\":[]}"' "filebase64"

expect_rejected "a rule with no branches" \
  '{"naming_pattern":"{.application.slug}"}' "branches"

expect_rejected "a branches that is not an array" \
  '{"branches":{".NET":["domain"]}}' "branches"

# An empty list is not a rule, it is a rule someone is halfway through writing.
expect_rejected "an empty branches" \
  '{"branches":[]}' "branches"

expect_rejected "a branch that is not an object" \
  '{"branches":["{.application.slug}"]}' "branch"

expect_rejected "a branch with no naming_pattern" \
  "{\"branches\":[{\"condition\":{\"$md.architecture\":\".NET\"}}]}" "naming_pattern"

expect_rejected "a condition that is not an object" \
  "{\"branches\":[{\"condition\":\"$md.architecture\",\"naming_pattern\":\"{$md.domain}\"}]}" "condition"

expect_rejected "a condition compared against a list" \
  "{\"branches\":[{\"condition\":{\"$md.architecture\":[\".NET\"]},\"naming_pattern\":\"{$md.domain}\"}]}" "condition"

# The paths are parsed, not evaluated as jq, so anything that is not a dotted
# path has to be refused as a rule problem rather than reaching jq.
expect_rejected "a path with no leading dot" \
  '{"branches":[{"naming_pattern":"{application.slug}"}]}' "application.slug"

expect_rejected "a path that is a jq expression" \
  '{"branches":[{"naming_pattern":"{.application.metadata | keys}"}]}' "naming_pattern"

expect_rejected "a placeholder that is never closed" \
  "{\"branches\":[{\"naming_pattern\":\"{$md.domain\"}]}" "closed"

# The branch that wins here is the first one, and it is fine. The bad
# placeholders are in a branch this application never reaches: checked only on
# expansion, they loaded without complaint and waited for the first application
# that did match that branch, to fail inside its before-create hook.
expect_rejected "a jq expression in a branch that does not win" \
  "{\"branches\":[{\"naming_pattern\":\"{$md.domain}\"},{\"naming_pattern\":\"{.application.metadata | keys}\"}]}" \
  "branch 1 has a placeholder"

expect_rejected "an unclosed placeholder in a branch that does not win" \
  "{\"branches\":[{\"naming_pattern\":\"{$md.domain}\"},{\"naming_pattern\":\"{$md.domain\"}]}" \
  "branch 1 has a naming_pattern with a \"{\" that is never closed"

# Every other scalar works as a condition value -- string, number, boolean -- and
# a list or an object is refused above. null was the one that passed the shape
# check and could then never match: `null | tostring` is "null" and an absent
# path yields "", so the branch is dead. With a catch-all in the rule that is
# silent, exactly like a misspelt path.
expect_rejected "a condition compared against null" \
  "{\"branches\":[{\"condition\":{\"$md.architecture\":null},\"naming_pattern\":\"{$md.domain}\"}]}" \
  "can never match"

# The same path shape the naming_pattern refuses. A condition used to take it:
# `ltrimstr(".")` is a no-op without the dot and `split(".")` still produces the
# right parts, so the rule author wrote it one way, it worked, and copying it
# into the pattern was what finally failed.
expect_rejected "a condition path with no leading dot" \
  "{\"branches\":[{\"condition\":{\"application.metadata.application.architecture\":\".NET\"},\"naming_pattern\":\"{$md.domain}\"}]}" \
  "application.metadata.application.architecture"

expect_rejected "a condition path that is a jq expression" \
  "{\"branches\":[{\"condition\":{\".application | keys\":\".NET\"},\"naming_pattern\":\"{$md.domain}\"}]}" \
  "is not a path"

# Nothing matched and no catch-all: the old code let this fall through to a name
# built from an empty pattern, reported as a success.
expect_rejected "no branch matching and no catch-all" \
  "{\"branches\":[{\"condition\":{\"$md.architecture\":\"Node\"},\"naming_pattern\":\"{$md.domain}\"}]}" "no branch"

exit "$failed"
